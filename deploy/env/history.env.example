# history: member_history search backfill, long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=history

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
INTERNAL_PROXY_URL=
INTERNAL_PROXY_TOKEN=
SLACK_TEAM_ID=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
MEMBER_HISTORY_POLL_SECONDS=
PROXY_ALLOW_PLAINTEXT=
TZ=UTC
