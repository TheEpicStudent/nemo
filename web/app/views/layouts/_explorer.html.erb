<section id="chart-explorer" class="explorer" role="dialog" aria-labelledby="chart-explorer-title"
         data-explorer-target="dialog" data-export-font="<%= asset_path("geist-variable.woff2") %>"
         data-turbo-permanent hidden>
  <div class="explorer-panel" data-explorer-target="panel" tabindex="-1">
    <header class="explorer-header">
      <div class="explorer-heading">
        <h2 class="explorer-title" id="chart-explorer-title" data-explorer-target="title"></h2>
        <span class="explorer-subtitle" data-explorer-target="subtitle" hidden></span>
        <span class="explorer-range" data-explorer-target="range" hidden>
          <span data-explorer-target="rangeLabel"></span>
          <span class="explorer-range-count" data-explorer-target="rangeCount"></span>
          <button type="button" class="explorer-range-apply" data-explorer-target="applyButton"
                  data-action="explorer#applyToPage" hidden>Apply to page</button>
          <button type="button" class="explorer-range-reset" data-action="explorer#resetZoom"
                  aria-label="Reset zoom" aria-keyshortcuts="0">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
        </span>
      </div>
      <div class="explorer-toolbar" role="toolbar" aria-label="Chart tools">
        <div class="explorer-tool-group" data-explorer-target="zoomControls" hidden>
          <span class="segmented explorer-tools" role="group" aria-label="Pointer">
            <button type="button" aria-pressed="true" aria-label="Select" aria-keyshortcuts="b"
                    data-explorer-target="toolButton" data-explorer-tool-param="select" data-action="explorer#chooseTool">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.034 12.681a.498.498 0 0 1 .647-.647l9 3.5a.5.5 0 0 1-.033.943l-3.444 1.068a1 1 0 0 0-.66.66l-1.067 3.443a.5.5 0 0 1-.943.033z"/><path d="M5 3a2 2 0 0 0-2 2M19 3a2 2 0 0 1 2 2M5 21a2 2 0 0 1-2-2M9 3h1M9 21h2M14 3h1M3 9v1M21 9v2M3 14v1"/></svg>
            </button>
            <button type="button" aria-pressed="false" aria-label="Pan" aria-keyshortcuts="h"
                    data-explorer-target="toolButton" data-explorer-tool-param="pan" data-action="explorer#chooseTool">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>
            </button>
          </span>
          <span class="explorer-separator" aria-hidden="true"></span>
          <button type="button" class="btn btn-ghost btn-sm btn-only" data-explorer-target="zoomOutButton"
                  data-action="explorer#zoomOut" aria-label="Zoom out" aria-keyshortcuts="-">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M8 11h6"/></svg>
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-only" data-explorer-target="zoomInButton"
                  data-action="explorer#zoomIn" aria-label="Zoom in" aria-keyshortcuts="+">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M11 8v6M8 11h6"/></svg>
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-only" data-explorer-target="zoomResetButton"
                  data-action="explorer#resetZoom" aria-label="Reset zoom" aria-keyshortcuts="0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          </button>
          <span class="explorer-separator" aria-hidden="true"></span>
        </div>
        <span class="segmented explorer-tools" role="group" aria-label="View">
          <button type="button" aria-pressed="true" aria-label="Chart" aria-keyshortcuts="1"
                  data-explorer-target="viewButton" data-explorer-view-param="chart" data-action="explorer#chooseView">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg>
          </button>
          <button type="button" aria-pressed="false" aria-label="Chart and table" aria-keyshortcuts="2"
                  data-explorer-target="viewButton" data-explorer-view-param="split" data-action="explorer#chooseView">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 12h18"/></svg>
          </button>
          <button type="button" aria-pressed="false" aria-label="Table" aria-keyshortcuts="3"
                  data-explorer-target="viewButton" data-explorer-view-param="table" data-action="explorer#chooseView">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          </button>
        </span>
        <div class="explorer-popover-anchor">
          <button type="button" class="btn btn-ghost btn-sm btn-only" data-explorer-target="displayButton"
                  data-action="explorer#toggleDisplay" aria-haspopup="dialog" aria-expanded="false"
                  aria-controls="chart-explorer-display" aria-label="Display" aria-keyshortcuts="d">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/>
            </svg>
          </button>
          <div class="menu-pop explorer-display" id="chart-explorer-display" role="dialog" aria-label="Display"
               tabindex="-1" data-explorer-target="display" hidden>
            <% ExploreHelper::DISPLAY_SETTINGS.each do |group, settings| %>
              <div class="explorer-settings-group" data-settings-group>
                <p class="explorer-settings-label"><%= group %></p>
                <% settings.each do |setting| %>
                  <div class="explorer-setting" data-setting="<%= setting[:key] %>">
                    <span class="explorer-setting-name">
                      <%= setting[:label] %>
                      <% if setting[:shortcut] %><span class="kbd"><%= setting[:shortcut] %></span><% end %>
                    </span>
                    <% if setting[:choices] %>
                      <span class="segmented" role="group" aria-label="<%= setting[:label] %>">
                        <% setting[:choices].each do |value, text, name| %>
                          <button type="button" aria-pressed="false" <% if name %>aria-label="<%= name %>"<% end %>
                                  data-action="explorer#chooseSetting"
                                  data-explorer-setting-param="<%= setting[:key] %>"
                                  data-explorer-choice-param="<%= value %>"><%= text %></button>
                        <% end %>
                      </span>
                    <% else %>
                      <button type="button" class="switch" role="switch" aria-checked="false"
                              aria-label="<%= setting[:label] %>" data-action="explorer#toggleSetting"
                              data-explorer-setting-param="<%= setting[:key] %>"></button>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
            <div class="explorer-settings-footer">
              <button type="button" class="btn btn-ghost btn-sm" data-action="explorer#resetDisplay">Reset</button>
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-ghost btn-sm btn-only" data-explorer-target="inspectorButton"
                data-action="explorer#toggleInspector" aria-pressed="false" aria-controls="chart-explorer-inspector"
                aria-label="Inspector" aria-keyshortcuts="i">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/>
          </svg>
        </button>
        <details class="menu explorer-menu" data-controller="menu" data-explorer-target="menu">
          <summary class="btn btn-ghost btn-sm btn-only" aria-haspopup="menu" aria-label="More">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
            </svg>
          </summary>
          <div class="menu-pop" role="menu" aria-label="More">
            <button type="button" role="menuitem" data-explorer-target="imageAction"
                    data-action="explorer#copyImage" aria-keyshortcuts="c">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              Copy image
              <span class="kbd explorer-menu-shortcut">C</span>
            </button>
            <button type="button" role="menuitem" data-explorer-target="imageAction"
                    data-action="explorer#exportImage" data-explorer-format-param="png">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
              Export PNG
            </button>
            <button type="button" role="menuitem" data-explorer-target="imageAction"
                    data-action="explorer#exportImage" data-explorer-format-param="svg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                <path d="m10 12.5-2 2.5 2 2.5M14 12.5l2 2.5-2 2.5"/>
              </svg>
              Export SVG
            </button>
            <div class="menu-sep"></div>
            <button type="button" role="menuitem" data-action="explorer#copyCsv">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              Copy CSV
            </button>
            <button type="button" role="menuitem" data-action="explorer#downloadCsv">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                <path d="M8 13h2M14 13h2M8 17h2M14 17h2"/>
              </svg>
              Download CSV
            </button>
            <div class="menu-sep" data-explorer-target="presentSeparator"></div>
            <button type="button" role="menuitem" data-explorer-target="presentAction"
                    data-action="explorer#togglePresentation" aria-keyshortcuts="f">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/>
              </svg>
              <span data-explorer-target="presentLabel">Present</span>
              <span class="kbd explorer-menu-shortcut">F</span>
            </button>
          </div>
        </details>
        <span class="explorer-separator" aria-hidden="true"></span>
        <button type="button" class="btn btn-ghost btn-sm btn-only" data-action="explorer#close"
                aria-label="Close" aria-keyshortcuts="Escape">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="explorer-body" data-explorer-target="body">
      <div class="explorer-main">
        <div class="explorer-legend" role="group" aria-label="Series" data-explorer-target="legend" hidden></div>
        <div class="explorer-plot" data-explorer-target="plot"
             data-action="chart:ready->explorer#chartReady chart:update->explorer#chartReady chart:point->explorer#chartPoint mousedown->explorer#rememberPin"></div>
        <div class="explorer-overview" data-explorer-target="overview" aria-hidden="true" hidden></div>
        <div class="explorer-split-handle" role="separator" aria-orientation="horizontal" aria-label="Resize table"
             tabindex="0" data-explorer-target="splitHandle"
             data-action="pointerdown->explorer#startResize pointermove->explorer#resize pointerup->explorer#endResize pointercancel->explorer#endResize keydown->explorer#resizeWithKeys"></div>
        <div class="explorer-table" data-explorer-target="table"
             data-action="pointerover->explorer#hoverRow pointerleave->explorer#leaveTable click->explorer#clickRow"></div>
      </div>
      <aside class="explorer-inspector" id="chart-explorer-inspector" aria-label="Inspector"
             data-explorer-target="inspector" hidden>
        <section class="explorer-inspector-section">
          <div class="explorer-inspector-head">
            <h3 class="explorer-inspector-label" data-explorer-target="pointHeading">Point</h3>
            <button type="button" class="btn btn-ghost btn-sm explorer-pin" data-explorer-target="pinButton"
                    data-action="explorer#togglePin" aria-pressed="false" aria-keyshortcuts="Enter" hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17v5"/>
                <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>
              </svg>
              <span data-explorer-target="pinLabel">Pin</span>
            </button>
          </div>
          <div class="explorer-point" data-explorer-target="point"></div>
        </section>
        <section class="explorer-inspector-section">
          <div class="explorer-inspector-head">
            <h3 class="explorer-inspector-label" data-explorer-target="statsHeading">In view</h3>
            <span class="explorer-inspector-range" data-explorer-target="statsRange"></span>
          </div>
          <div class="explorer-stats" data-explorer-target="stats"></div>
        </section>
      </aside>
      <span class="visually-hidden" aria-live="polite" data-explorer-target="announcer"></span>
      <div class="topbar-msgs" aria-live="polite" data-explorer-target="toastRegion"></div>
      <template data-explorer-target="toastTemplate">
        <%= render "layouts/flash", notice: "Done", alert: nil, detail: nil, action: nil, tone: "good" %>
      </template>
      <template data-explorer-target="warningTemplate">
        <%= render "layouts/flash", alert: "Failed", notice: nil, detail: nil, action: nil, tone: "warn" %>
      </template>
    </div>
  </div>
</section>
