<div class="section">
  <div class="section-head">
    <h2 class="section-title">Day coverage</h2>
  </div>

  <div class="grid g-sided">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Retention metrics</h2>
          <p class="card-sub"><%= pluralize(consecutive_days, "day") %> consecutive</p>
        </div>
      </div>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th class="col-num">Required</th>
              <th>Progress</th>
              <th class="col-num">Available</th>
            </tr>
          </thead>
          <tbody>
            <% EngineController::RETENTION_DAY_REQUIREMENTS.each do |label, required_days| %>
              <% share = required_days.positive? ? [consecutive_days.to_f / required_days * 100, 100].min : 0 %>
              <tr>
                <td><%= label %></td>
                <td class="col-num"><%= pluralize(required_days, "day") %></td>
                <td class="cell-share">
                  <div class="inbar <%= "soft" if share < 50 %>">
                    <span><i style="width: <%= [share, 2].max.round %>%"></i></span>
                    <span><%= share.round %>%</span>
                  </div>
                </td>
                <td class="col-num">
                  <%= consecutive_days >= required_days ? "Now" : (Date.current + (required_days - consecutive_days)).strftime("~%-d %b %Y") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card card-flush">
      <div class="card-head">
        <div><h2 class="card-title">Days by source</h2></div>
      </div>

      <% if day_coverage.any? %>
        <div class="covrows">
          <% day_coverage.each do |row| %>
            <div class="covrow">
              <div class="covhead">
                <span class="covkey"><%= row.source %></span>
                <span class="cov-label">
                  <%= row.first_ds.strftime("%-d %b %Y") %> to <%= row.last_ds.strftime("%-d %b %Y") %>,
                  <%= pluralize(row.span, "day") %>
                </span>
              </div>
              <div class="covbar" role="img"
                   aria-label="<%= number_with_delimiter(row.loaded) %> of <%= number_with_delimiter(row.span) %> days loaded">
                <% day_shares(row.never_fetched, row.unavailable, row.loaded).each do |state, count, width| %>
                  <i class="<%= state %>" style="width: <%= width %>%"></i>
                <% end %>
              </div>
              <div class="cov-label">
                <%= number_with_delimiter(row.loaded) %> loaded
                &middot; <%= number_with_delimiter(row.unavailable) %> unavailable
                <% if row.never_fetched.positive? %>
                  &middot; <%= number_with_delimiter(row.never_fetched) %> before start
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="key">
          <span><i class="lg-held"></i>loaded</span>
          <span><i class="lg-nofile"></i>unavailable</span>
          <span><i class="lg-before"></i>before start</span>
        </div>
      <% else %>
        <div class="empty"><p class="empty-title">No data</p></div>
      <% end %>
    </div>

  </div>
</div>
