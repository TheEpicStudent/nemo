<div class="section">
  <div class="section-head">
    <h2 class="section-title">Global settings</h2>
  </div>

  <div class="grid g-1">
    <div class="card card-flush">
      <div class="card-head">
        <div><h2 class="card-title">Schedule</h2></div>
      </div>
      <div class="card-body flush">
        <% Engine::Setting::ENGINE_SETTINGS.each do |name, definition| %>
          <div class="tgrid tgrid-schedule">
            <div class="tstack"><b><%= definition[:label] %></b></div>
            <div class="tcell">
              <%= render "setting_value", source: Engine::Setting::ENGINE, name: name,
                    may_edit_setting: may_edit_setting, show_default: true %>
            </div>
            <div class="sub align-right">
              <% row = Engine::Setting.find_by(source: Engine::Setting::ENGINE, name: name) %>
              <%= row ? "#{row.changed_by}, #{time_ago_in_words(row.changed_at)} ago" : "Default" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "limits", sources: sources, may_edit_setting: may_edit_setting %>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">Per source</h2>
  </div>

  <div class="card card-flush">
    <div class="card-body flush scroll">
      <div class="tgrid thead">
        <div>Source</div>
        <div class="tcell">Cadence</div>
        <div class="tcell">Retention</div>
        <div class="tcell">Enabled</div>
      </div>
      <% sources.each do |row| %>
        <% source = row.source %>
        <div class="tgrid">
          <div class="tstack"><b><%= source.key %></b><span><%= source.label %></span></div>
          <div class="tcell">
            <%= render "setting_value", source: source.key, name: Engine::Setting::CADENCE,
                  may_edit_setting: may_edit_setting, show_default: true %>
          </div>
          <div class="tcell">
            <%= render "setting_value", source: source.key, name: Engine::Setting::RETENTION,
                  may_edit_setting: may_edit_setting, show_default: true %>
          </div>
          <div class="tcell">
            <%= render "setting_value", source: source.key, name: Engine::Setting::ENABLED,
                  may_edit_setting: may_edit_setting, show_default: true %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
