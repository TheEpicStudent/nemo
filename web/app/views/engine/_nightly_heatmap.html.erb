<% labels = EngineHelper::CELL_LABELS %>
<div class="scroll matrix-scroll" data-controller="chart-tooltip"
     data-action="mouseover->chart-tooltip#show mouseleave->chart-tooltip#clear">
<div class="nights-h">
  <div>Source</div>
  <div class="nights">
    <% nights.each_with_index do |night, i| %>
      <span><%= night.strftime("%-d") if (i % 5) == 4 || i == nights.size - 1 %></span>
    <% end %>
  </div>
  <div class="align-right">Missed</div>
</div>

<% if defined?(nightly) && nightly.present? %>
  <% missed = nightly.count { |cell| cell == "none" } %>
  <div class="srow">
    <div class="stat-key">
      <i class="dot <%= nightly.last == "run" ? "run" : (nightly.last(2).include?("ok") ? "live" : "stale") %>"></i>
      <b>Nightly</b>
    </div>
    <div class="cells" role="group" aria-label="Nightly, last <%= nights.size %> nights">
      <% nightly.each_with_index do |cell, i| %>
        <i class="<%= cell %>" tabindex="0" role="img" data-tip="<%= night_tip("Nightly", nights[i], cell) %>"
           aria-label="<%= nights[i].strftime("%-d %b") %>, <%= labels[cell] %>"></i>
      <% end %>
    </div>
    <div class="stat-value <%= "warn" if missed.positive? %>"><%= missed.positive? ? missed : "n/a" %></div>
  </div>
<% end %>

<% matrix.each do |source, cells| %>
  <% missed = cells.count { |cell| cell == "none" || cell == "fail" } %>
  <% state = cells.last == "run" ? "run" : (cells.last(2).include?("ok") ? "live" : "stale") %>
  <%= link_to engine_path(tab: "sources", open: source.key), class: "srow" do %>
    <div class="stat-key">
      <i class="dot <%= state %>"></i>
      <b><%= source.key %></b>
    </div>
    <div class="cells" role="group" aria-label="<%= source.key %>, last <%= nights.size %> nights">
      <% cells.each_with_index do |cell, i| %>
        <i class="<%= cell %>" tabindex="0" role="img" data-tip="<%= night_tip(source.key, nights[i], cell) %>"
           aria-label="<%= nights[i].strftime("%-d %b") %>, <%= labels[cell] %>"></i>
      <% end %>
    </div>
    <div class="stat-value <%= "warn" if missed.positive? %>"><%= missed.positive? ? missed : "n/a" %></div>
  <% end %>
<% end %>

</div>

<div class="key">
  <span><i class="lg-ran"></i>ran</span>
  <span><i class="lg-part"></i>partial</span>
  <span><i class="lg-skip"></i>skipped</span>
  <span><i class="lg-stop"></i>cancelled</span>
  <span><i class="lg-gone"></i>abandoned</span>
  <span><i class="lg-fail"></i>failed</span>
  <span><i class="lg-none"></i>not run</span>
  <span><i class="lg-wait"></i>not started</span>
  <span><i class="lg-run"></i>running</span>
</div>
