<% search = @query.search %>
<% categories = search.of("category") %>
<% actions = search.of("action") %>
<% networks = search.of("network") %>
<% after = search.first_value("after") %>
<% last = search.first_value("last") %>
<% actor_type = search.first_value("is") %>
<% high_volume = search.first_value("show") == "high_volume" %>
<div class="audit-filters">
  <% if @query.may_slack? %>
    <%= render layout: "shared/dropdown", locals: {
          label: "Category", trigger_css: "btn",
          trigger: audit_filter_trigger("Category", categories.first && Fd::AuditCatalogue.category_label(categories.first)) } do %>
      <%= render "facet_frame", facet: "category" %>
    <% end %>

    <%= render layout: "shared/dropdown", locals: {
          label: "Event", trigger_css: "btn", pop_css: "audit-filter-pop",
          trigger: audit_filter_trigger("Event", actions.first && Fd::AuditCatalogue.action_label(actions.first)) } do %>
      <%= render "facet_frame", facet: "action" %>
    <% end %>
  <% end %>

  <% before = search.first_value("before") %>
  <% from = after && Date.iso8601(after[0, 10]) %>
  <% upto = before ? Date.iso8601(before[0, 10]) - (before.include?("T") ? 0 : 1) : (from && Date.current) %>
  <%= render "shared/date_range", url: fd_audit_path, title: "Time",
        start_on: from, end_on: upto, min: AuditHelper::FIRST_DAY, max: Date.current,
        hidden_params: @query.set_params(%w[after before last]),
        presets: [{ label: "Any time", href: fd_audit_path(@query.set_params(%w[after before last])),
                    current: after.nil? && before.nil? && last.nil? }] +
          AuditHelper::WINDOWS.map { |label, window|
            { label: label, href: fd_audit_path(@query.set_params(%w[last after before], window)),
              current: last == window && after.nil? && before.nil? }
          } %>

  <% if @query.may_slack? %>
    <%= render layout: "shared/dropdown", locals: {
          label: "Network", trigger_css: "btn",
          trigger: audit_filter_trigger("Network", networks.map { |key| Fd::AuditSearch::NETWORKS.fetch(key) }.join(", ").presence) } do %>
      <%= render "facet_frame", facet: "network" %>
    <% end %>
  <% end %>

  <%= render layout: "shared/dropdown", locals: {
        label: "Actor type", trigger_css: "btn",
        trigger: audit_filter_trigger("Actor type", AuditHelper::ACTOR_TYPES.key(actor_type)) } do %>
    <%= render "facet_frame", facet: "is" %>
  <% end %>

  <%= render layout: "shared/dropdown", locals: {
        label: "Group by", trigger_css: "btn",
        trigger: audit_filter_trigger("Group by", @query.group_label) } do %>
    <%= link_to "None", fd_audit_path(@query.to_params.except("group")), aria: { current: ("true" if @query.group.nil?) } %>
    <div class="menu-sep"></div>
    <% @query.allowed_groups.each do |key, label| %>
      <%= link_to label, fd_audit_path(@query.to_params.merge("group" => key)),
            aria: { current: ("true" if @query.group == key) } %>
    <% end %>
  <% end %>

  <% if @query.may_slack? %>
    <%= render layout: "shared/dropdown", locals: {
          label: "High-volume actions", trigger_css: "btn",
          trigger: audit_filter_trigger("High-volume", high_volume ? "Shown" : "Hidden") } do %>
      <%= link_to "Hidden", fd_audit_path(@query.set_params("show")), aria: { current: ("true" unless high_volume) } %>
      <%= link_to "Shown", fd_audit_path(@query.set_params("show", "high_volume")), aria: { current: ("true" if high_volume) } %>
    <% end %>
  <% end %>
</div>
