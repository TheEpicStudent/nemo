<% content_for :page_title, "Audit log" %>

<% content_for :head_actions do %>
  <%= link_to fd_audit_path(@query.live_toggle_params), class: "btn", aria: { pressed: @query.live? } do %>
    <span class="audit-live-dot" aria-hidden="true"></span>Live
  <% end %>
  <%= render "saved" %>
  <button type="button" class="btn" data-controller="audit-csv"
          data-audit-csv-url-value="<%= fd_audit_export_path(@query.to_params) %>"
          data-action="audit-csv#copy">
    <%= audit_icon("copy") %><span data-audit-csv-target="label">Copy CSV</span>
  </button>
  <button type="button" class="btn btn-only" data-modal-open="audit-help"
          aria-haspopup="dialog" aria-label="Query syntax">?</button>
<% end %>

<% content_for :page_controls do %>
  <%= render "query_bar" %>
<% end %>

<% content_for :page_tabs do %>
  <% @views.each do |view| %>
    <%= link_to fd_audit_path(@query.view_params(view.key)), class: "view",
          aria: { current: ("true" if view.current) } do %>
      <%= view.label %>
      <span class="view-count"><%= number_with_delimiter(view.count) %></span>
    <% end %>
  <% end %>
<% end %>

<div class="stack">
  <%= render "filters" %>

  <% if @rows.any? || @groups.any? %>
    <turbo-frame id="audit-histogram" class="audit-histogram" loading="lazy"
                 src="<%= fd_audit_histogram_path(@query.to_params) %>"></turbo-frame>
  <% end %>

  <% live = @query.live? && @query.newest_page? %>
  <% live_watch = live ? @query.live_watch : nil %>
  <% if live_watch %>
    <%= turbo_stream_from Fd::AuditLiveBroadcast::STREAM %>
  <% end %>
  <turbo-frame id="audit-results" class="stack" target="_top"
    <%= tag.attributes(data: { controller: ["audit-rows", ("audit-live" if live)].compact.join(" "),
                               audit_live_url_value: (fd_audit_rows_path(@query.to_params) if live),
                               audit_live_watch_value: live_watch&.to_json }) %>>
    <%= render "results" %>
  </turbo-frame>
</div>

<%= render layout: "fd/modal", locals: { id: "audit-help", title: "Query syntax",
      open: false } do %>
  <div class="modal-body">
    <dl class="audit-help-list">
      <% Fd::AuditQuery::HELP.each do |term, description| %>
        <dt><button type="button" class="chip audit-help-try"
                    data-controller="fill-search" data-action="click->fill-search#use"
                    data-fill-search-term-value="<%= term %>"><%= term %></button></dt>
        <dd><%= description %></dd>
      <% end %>
    </dl>
  </div>
  <div class="modal-foot">
    <button type="button" class="btn btn-ghost" data-action="click->modal#close">Close</button>
  </div>
<% end %>

<% content_for :side do %>
  <aside class="side-pane" aria-label="Event">
    <turbo-frame id="audit-panel" target="_top" data-controller="side-pane"></turbo-frame>
  </aside>
<% end %>
