<% content_for :page_title, "Overview" %>
<% content_for :head_actions do %>
  <%= link_to "Open case", fd_cases_path(open: "1"), class: "btn btn-primary" %>
<% end %>

<% metric_go = capture do %>
  <svg class="metric-go" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
<% end %>

<div class="metrics" data-controller="spotlight count-up"
     data-action="pointermove->spotlight#move pointerleave->spotlight#leave">
  <%= link_to fd_cases_path, class: "metric" do %>
    <%= metric_go %>
    <span class="metric-key">Open cases</span>
    <span class="metric-value"><%= @open %></span>
    <span class="metric-note">
      <% if @unclaimed.positive? %>
        <span class="delta-down"><%= @unclaimed %></span>
        <span>unassigned</span>
      <% else %>
        <span>all assigned</span>
      <% end %>
    </span>
  <% end %>
  <%= link_to fd_cases_path(view: "resolved"), class: "metric" do %>
    <%= metric_go %>
    <span class="metric-key">Median time to resolve</span>
    <span class="metric-value"><%= @resolve_lag ? case_age_label(@resolve_lag) : "n/a" %></span>
    <span class="metric-note"><span>from report received</span></span>
  <% end %>
  <%= link_to fd_members_path(view: "force"), class: "metric" do %>
    <%= metric_go %>
    <span class="metric-key">In force</span>
    <span class="metric-value"><%= @guards.size %></span>
    <span class="metric-note">
      <% if @guards.empty? %>
        <span>none</span>
      <% elsif @orphaned.positive? %>
        <span class="delta-down"><%= @orphaned %></span>
        <span>attached to no case</span>
      <% else %>
        <span>all linked to a case</span>
      <% end %>
    </span>
  <% end %>
  <%= link_to fd_audit_path(view: "engine", q: "last:30d"), class: "metric" do %>
    <%= metric_go %>
    <span class="metric-key">Actions, 30 days</span>
    <span class="metric-value"><%= @actions_total %></span>
    <span class="metric-note"><span><%= @reversed %> reversed</span></span>
  <% end %>
</div>

<% if @guards.any? %>
  <%= render "in_force", guards: @guards, names: @names %>
<% end %>

<% if @endings.any? %>
  <%= render "endings", endings: @endings, closed: @closed_count %>
<% end %>
