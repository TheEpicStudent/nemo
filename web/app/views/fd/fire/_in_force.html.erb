<section class="section">
  <div class="section-head">
    <h2 class="section-title">In force now</h2>
  </div>

  <div class="card card-flush">
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Member</th>
            <th>Guard</th>
            <th>Since</th>
            <th>Until</th>
            <th>Case</th>
            <th>Nemo</th>
          </tr>
        </thead>
        <tbody>
          <% guards.each do |guard| %>
            <tr>
              <td><%= member_face(guard.subject_id) %></td>
              <td><%= guard_kind_line(guard) %></td>
              <td><%= Fd::ShortDate.for(guard.opened_at) %></td>
              <td class="<%= "is-none" unless guard.expires_at %>">
                <%= guard.expires_at ? Fd::ShortDate.ending(guard.expires_at) : "no end date" %>
              </td>
              <td>
                <% if guard.case_id %>
                  <%= link_to "##{guard.case_id}", fd_case_path(guard.case_id) %>
                <% else %>
                  <span class="na">None</span>
                <% end %>
              </td>
              <td><%= guard_enforcement_chip(guard) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
