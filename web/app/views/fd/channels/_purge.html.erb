<div class="stack">
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Purge</h2>
      <div class="card-tools">
        <%= opens_modal current_account.may?("channel.purge") ? "channel.purge" : "member.purge",
              "Purge messages", opens: "purge-channel", css: "btn btn-sm btn-danger" %>
      </div>
    </div>

    <% if purges.any? %>
      <div class="list purge-list">
        <% purges.each do |purge| %>
          <div class="lrow">
            <span class="grow">
              <span class="lrow-head">
                <b><%= link_to purge_scope(purge),
                      fd_channel_purge_path(channel_id, purge), class: "lnk" %></b>
                <% if purge.member_id %>
                  <span class="sub">from <%= member_face(purge.member_id, small: true) %></span>
                <% end %>
                <%= purge_state_chip(purge) %>
              </span>
              <% if purge.reason.present? %>
                <span class="sub"><%= purge.reason %></span>
              <% end %>
              <span class="sub">
                <%= member_face(purge.asked_by, small: true) %> ·
                <%= at_minute(purge.asked_at) %>
                <% if purge_source(purge) %>
                  · <%= purge_source(purge) %>
                <% end %>
                · <%= purge_progress(purge) %>
                <% if purge.error.present? %>
                  · <%= purge.error %>
                <% end %>
              </span>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">Nothing purged</p>
      </div>
    <% end %>
  </div>
</div>

<% if current_account.may?("channel.purge") || current_account.may?("member.purge") %>
  <%= render "purge_modal", channel_id: channel_id, label: label %>
<% end %>
