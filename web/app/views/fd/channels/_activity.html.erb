<% if events.any? %>
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Activity</h2>
    </div>
    <div class="activity">
      <% events.each do |event| %>
        <div class="activity-item">
          <div class="line-row">
            <%= guard_face(event.subject_id) %>
            <span class="grow two-line">
              <span class="lrow-head">
                <b><%= bot_name_link(activity_who(event, labels), event.app_id) %></b>
                <%= activity_verb(event) %>
              </span>
              <span><%= activity_ids(event) %></span>
            </span>
            <span class="row-right">
              <span class="sub2 mono"><%= at_minute(event.at) %></span>
            </span>
          </div>

          <% if event.message_text.present? %>
            <span class="queue-cite">
              <span class="queue-cite-body"><%= plain_text(event.message_text) %></span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
