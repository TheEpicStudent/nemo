<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Slow mode</h2>
    <div class="card-tools">
      <% if guard %>
        <%= opens_modal "channel.guard", "Exempt member", opens: "allow-bot", css: "btn btn-sm" %>
        <%= opens_modal "channel.guard", "Extend", opens: "slowmode-extend", css: "btn btn-sm" %>
        <%= gated_button("channel.guard", "Disable",
              fd_channel_guard_path(channel_id, Fd::ChannelGuard::SLOWMODE),
              css: "btn btn-sm btn-danger", method: :delete) %>
      <% else %>
        <%= opens_modal "channel.guard", "Enable", opens: "slowmode-enable",
              css: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if guard %>
    <div class="setlist">
      <div class="setline">
        <span class="setname">Ends</span>
        <span class="setval"><%= time_left(guard.expires_at) %></span>
      </div>
      <div class="setline">
        <span class="setname">Cooldown</span>
        <span class="setval"><%= cooldown_label(guard.seconds) %></span>
      </div>
      <div class="setline">
        <span class="setname">Threads</span>
        <span class="setval"><%= guard.threads? ? "Included" : "Excluded" %></span>
      </div>
      <% if guard.reason.present? %>
        <div class="setline">
          <span class="setname">Reason</span>
          <span class="setval"><%= guard.reason %></span>
        </div>
      <% end %>
      <div class="setline">
        <span class="setname">Enabled by</span>
        <span class="setval"><%= member_face(guard.opened_by, small: true) %></span>
      </div>
    </div>
    <%= render "allows", channel_id: channel_id, guard: guard, allows: allows %>
  <% else %>
    <div class="empty"><p class="empty-title">Off</p></div>
  <% end %>
</div>

<% if guard %>
  <%= render layout: "fd/modal", locals: { id: "slowmode-extend", title: "Extend slow mode" } do %>
    <%= form_with url: fd_channel_guard_path(channel_id, Fd::ChannelGuard::SLOWMODE), method: :patch,
          html: { autocomplete: "off" } do %>
      <div class="modal-body" data-controller="duration">
        <label class="field-label">
          Extend by
          <%= select_tag :extend_by, options_for_select(duration_options("+")), prompt: "Select",
                class: "select", id: nil, required: true,
                data: { duration_target: "select", action: "change->duration#toggle" } %>
        </label>
        <%= render "fd/custom_end" %>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Extend", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= render layout: "fd/modal", locals: { id: "slowmode-enable", title: "Enable slow mode" } do %>
    <%= form_with url: fd_channel_guard_path(channel_id, Fd::ChannelGuard::SLOWMODE), method: :post,
          html: { autocomplete: "off" } do %>
      <div class="modal-body" data-controller="duration">
        <label class="field-label">
          Duration
          <%= select_tag :duration, options_for_select(duration_options), include_blank: "No end",
                class: "select", id: nil,
                data: { duration_target: "select", action: "change->duration#toggle" } %>
        </label>
        <%= render "fd/custom_end" %>
        <label class="field-label">
          Cooldown (seconds)
          <%= number_field_tag :seconds, Fd::ChannelGuard::SECONDS_TO_START, class: "input", id: nil,
                min: 1, max: Fd::ChannelGuard::SLOWEST, required: true %>
        </label>
        <label class="tickline">
          <%= check_box_tag :threads, "1", false, class: "tick", id: nil %>
          Also in threads
        </label>
        <label class="field-label">
          Reason
          <%= text_area_tag :reason, nil, rows: 2, class: "textarea", id: nil, maxlength: 500,
                required: true %>
        </label>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Enable", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
