<% current = compare.verdict&.verdict %>
<% target = compare.alt_target %>
<%= form_with url: fd_link_verdicts_path, method: :post, class: "px-verdictbar",
      html: { autocomplete: "off" }, data: { controller: "verdict-keys" } do %>
  <%= hidden_field_tag :a, compare.a, id: nil %>
  <%= hidden_field_tag :b, compare.b, id: nil %>
  <%= hidden_field_tag :back, fd_link_compare_path(a: compare.a, b: compare.b, back: @back), id: nil %>
  <% Fd::LinkVerdict::VERDICTS.each_with_index do |(key, label), index| %>
    <button type="submit" name="verdict" value="<%= key %>" class="btn btn-sm"
            aria-pressed="<%= current == key %>" data-verdict-keys-target="choice" data-key="<%= index + 1 %>">
      <%= label %> <span class="kbd"><%= index + 1 %></span>
    </button>
  <% end %>
  <%= text_field_tag :note, compare.verdict&.note, class: "input input-sm grow", placeholder: "Note",
        aria: { label: "Note" }, id: nil %>
  <% if target && current_account.may?("member.deactivate") %>
    <button type="button" class="btn btn-sm btn-danger" data-modal-open="member-deactivate" aria-haspopup="dialog"
            data-verdict-keys-target="choice" data-key="d">
      Deactivate <%= person_label(target.user_id) %> as alt <span class="kbd">D</span>
    </button>
  <% end %>
<% end %>
