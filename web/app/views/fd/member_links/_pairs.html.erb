<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Accounts that look like one person</h2>
  </div>

  <% if @links.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>One</th>
            <th>The other</th>
            <th>Score</th>
            <th>Reasons</th>
            <th>Last seen</th>
            <th>Verdict</th>
          </tr>
        </thead>
        <tbody>
          <% @links.each do |link| %>
            <tr>
              <td><%= member_face(link.a_user_id) %></td>
              <td><%= member_face(link.b_user_id) %></td>
              <td><%= link_score_chip(link.score) %></td>
              <td class="link-why"><%= link_reasons(Fd::MemberLink.evidence_of(link.signals)) %></td>
              <td class="sub2"><%= link.last_seen ? on_day(link.last_seen) : "n/a" %></td>
              <% verdict = Fd::LinkVerdict.of(@verdicts, link.a_user_id, link.b_user_id) %>
              <td><%= verdict_cell(link.a_user_id, link.b_user_id, verdict) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No links</p>
    </div>
  <% end %>
</div>
