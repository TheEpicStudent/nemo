<% content_for :page_title, "Links" %>

<% content_for :page_tabs do %>
  <% Fd::LinkList::VIEWS.each do |key, label| %>
    <%= link_to fd_links_path(@list.params_for(view: key, signal: nil)), class: "view",
          aria: { current: ("true" if @list.view == key) } do %>
      <%= label %><span class="view-count"><%= number_with_delimiter(@list.view_counts.fetch(key)) %></span>
    <% end %>
  <% end %>
<% end %>

<% content_for :tab_tools do %>
  <%= render layout: "shared/dropdown", locals: {
        label: "Signal", trigger_css: "btn",
        trigger: audit_filter_trigger("Signal", @list.signal_label) } do %>
    <%= link_to "Any", fd_links_path(@list.params_for(signal: nil)), class: "btn",
          aria: { current: ("true" if @list.signal.nil?) } %>
    <div class="menu-sep"></div>
    <% Fd::LinkList::SIGNAL_GROUPS.each do |key, (label, _section)| %>
      <%= link_to fd_links_path(@list.params_for(signal: key)), class: "btn",
            aria: { current: ("true" if @list.signal == key) } do %>
        <span><%= label %></span><%= audit_count(@list.signal_counts.fetch(key)) %>
      <% end %>
    <% end %>
  <% end %>
  <% if @list.view == "sampled" && @list.variants.size > 1 %>
    <%= render layout: "shared/dropdown", locals: {
          label: "Set", trigger_css: "btn",
          trigger: audit_filter_trigger("Set", @list.variant_label) } do %>
      <% @list.variants.each do |name| %>
        <%= link_to (name == Fd::LinkList::LIVE_VARIANT ? "Live links" : name),
              fd_links_path(@list.params_for(variant: name)), class: "btn",
              aria: { current: ("true" if @list.variant == name) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream_from Fd::MemberLinkBroadcast::LIST_STREAM %>

<%= turbo_frame_tag Fd::MemberLinkBroadcast::LIST_FRAME, target: "_top",
      data: { src: fd_links_path(@list.params_for(page: @list.page)) } do %>
  <div class="stack">
    <div class="card card-flush">
      <% if @list.rows.any? %>
        <div class="scroll">
          <table class="data-table link-table">
            <thead>
              <tr>
                <th>Accounts</th>
                <th>Score</th>
                <th>Signals</th>
                <th>Verdict</th>
                <th>Last seen</th>
              </tr>
            </thead>
            <tbody>
              <% @list.rows.each do |row| %>
                <tr class="link-row">
                  <td><%= link_pair(row.a_user_id, row.b_user_id) %></td>
                  <td>
                    <%= link_band_state(row.score) %>
                    <% if row.label %><span class="sub2"><%= link_label_text(row.label) %></span><% end %>
                  </td>
                  <td class="link-why"><%= link_signal_lines(row.evidence) %></td>
                  <td>
                    <div class="verdict-cell">
                      <%= link_verdict_state(row.verdict, title: (["by #{names[row.decided_by]}", row.note].compact.join(", ") if row.verdict)) %>
                      <%= link_review_button(row.a_user_id, row.b_user_id, row.verdict,
                            variant: (@list.variant unless @list.variant == Fd::LinkList::LIVE_VARIANT)) %>
                    </div>
                  </td>
                  <td class="sub2"><%= row.last_seen ? on_day(row.last_seen) : "n/a" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty"><p class="empty-title">No links</p></div>
      <% end %>
    </div>

    <% if @list.total_pages > 1 %>
      <%= render "shared/pager", page: @list.page, pages: @list.total_pages, frame: Fd::MemberLinkBroadcast::LIST_FRAME,
            back_href: (fd_links_path(@list.params_for(page: @list.page - 1)) if @list.page > 1),
            next_href: (fd_links_path(@list.params_for(page: @list.page + 1)) if @list.page < @list.total_pages) %>
    <% end %>
  </div>
<% end %>
