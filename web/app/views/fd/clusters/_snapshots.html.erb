<section class="card card-flush">
  <% if cluster.snapshots.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Account</th>
            <th>Deactivated</th>
            <th>By</th>
            <th>Reason</th>
            <th>Email</th>
            <th>IPs</th>
            <th>Clients</th>
          </tr>
        </thead>
        <tbody>
          <% cluster.snapshots.each do |snap| %>
            <tr>
              <td><%= member_face(snap.user_id) %></td>
              <td class="sub2"><%= on_day(snap.deactivated_at) %></td>
              <td><%= snap.actor_id ? member_face(snap.actor_id) : (snap.source == "slack" ? "Slack admin" : "n/a") %></td>
              <td class="sub2"><%= snap.reason.presence || "n/a" %></td>
              <td><% if snap.email.present? %><span class="mono"><%= snap.email %></span><% else %><span class="sub2">n/a</span><% end %></td>
              <td>
                <% if snap.addresses.empty? %><span class="sub2">n/a</span><% end %>
                <% snap.addresses.first(4).each do |address| %><div class="mono"><%= address %></div><% end %>
              </td>
              <td class="sub2">
                <% if snap.clients.empty? %>n/a<% end %>
                <% snap.clients.first(3).each do |client| %><div title="<%= client %>"><%= client.truncate(40) %></div><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty"><p class="empty-title">No deactivated accounts</p></div>
  <% end %>
</section>
