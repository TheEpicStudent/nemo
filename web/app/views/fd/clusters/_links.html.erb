<section class="card card-flush">
  <% if cluster.links.any? %>
    <div class="scroll">
      <table class="data-table link-table">
        <thead>
          <tr><th>Pair</th><th>Score</th><th>Signals</th><th>Verdict</th><th>Last seen</th></tr>
        </thead>
        <tbody>
          <% cluster.links.sort_by { |edge| -edge.score }.each do |edge| %>
            <tr>
              <td><%= link_pair(edge.a_user_id, edge.b_user_id) %></td>
              <td><%= link_band_state(edge.score) %></td>
              <td class="link-why"><%= link_signal_lines(edge.evidence) %></td>
              <td>
                <div class="verdict-cell">
                  <%= link_verdict_state(edge.verdict) %>
                  <%= link_review_button(edge.a_user_id, edge.b_user_id, edge.verdict) %>
                </div>
              </td>
              <td class="sub2"><%= edge.last_seen ? on_day(edge.last_seen) : "n/a" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty"><p class="empty-title">No links</p></div>
  <% end %>
</section>
