<div class="stack">
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Autoresponse</h2>
      <label class="card-tools tickline">
        <%= check_box_tag :on, "1", @autoresponse_on, class: "switch", id: nil, form: "autoresponse-form",
              aria: { label: "Autoresponse" } %>
        <%= render "fd/configuration/switch_state" %>
      </label>
    </div>
    <%= form_with url: fd_configuration_autoresponse_path, method: :post, id: "autoresponse-form",
          class: "card-body settings-form", html: { autocomplete: "off" } do %>
      <label class="settings-row">
        <span class="settings-label">Emoji</span>
        <%= text_field_tag :emoji, @autoresponse_emoji.join(", "), class: "input", id: nil,
              placeholder: "fd-reason, blunder" %>
      </label>
      <div class="settings-row">
        <span class="settings-label">Channel</span>
        <div class="settings-control">
          <%= render "shared/combobox", kind: "channel", name: :channel_id, label: "Search channels" %>
          <% if @autoresponse_channel.present? %>
            <span class="sub2">Current: <%= channel_link(@autoresponse_channel) %></span>
            <%= channel_membership_label(*@autoresponse_membership) %>
          <% end %>
        </div>
      </div>
      <label class="settings-row">
        <span class="settings-label">Cooldown (days)</span>
        <%= number_field_tag :cooldown_days, @autoresponse_cooldown, class: "input settings-short",
              id: nil, min: 1, max: Fd::ResponsesController::MAX_COOLDOWN_DAYS %>
      </label>
      <label class="settings-row">
        <span class="settings-label">Reply</span>
        <span class="settings-control">
          <%= text_area_tag :body, @autoresponse_body, rows: 10, class: "textarea", id: nil,
                maxlength: Fd::ResponsesController::MAX_BODY_LENGTH %>
          <span class="field-vars">Variables: <code>{member}</code></span>
        </span>
      </label>
    <% end %>
    <div class="card-foot">
      <%= submit_tag "Save", class: "btn btn-primary", form: "autoresponse-form" %>
    </div>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Unsubscribe shield</h2>
      <label class="card-tools tickline">
        <%= check_box_tag :on, "1", @unsub_on, class: "switch", id: nil, form: "unsub-shield-form",
              aria: { label: "Unsubscribe shield" } %>
        <%= render "fd/configuration/switch_state" %>
      </label>
    </div>
    <%= form_with url: fd_configuration_unsub_shield_path, method: :post, id: "unsub-shield-form",
          class: "card-body settings-form", html: { autocomplete: "off" } do %>
      <label class="settings-row">
        <span class="settings-label">Link</span>
        <%= text_field_tag :link, @unsub_link, class: "input", id: nil,
              placeholder: "https://unsub.hack.club" %>
      </label>
    <% end %>
    <div class="card-foot">
      <%= submit_tag "Save", class: "btn btn-primary", form: "unsub-shield-form" %>
    </div>
  </div>
</div>
