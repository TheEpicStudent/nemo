<%= form_with url: fd_merge_cases_path, method: :post, data: { turbo_frame: "_top" } do %>
  <% plan.all.each do |kase| %>
    <%= hidden_field_tag "case_ids[]", kase.id, id: nil %>
  <% end %>
  <% local_assigns.fetch(:query_params, {}).each do |key, value| %>
    <%= hidden_field_tag key, value, id: nil %>
  <% end %>

  <div class="merge-outcome">
    <p class="merge-note">
      <b><%= merge_hold_line(plan) %></b>
      <%= merge_thread_line(plan) %>
      <%= merge_fold_line(plan) %>
    </p>
    <p class="merge-counts">Then on #<%= plan.primary.id %>: <%= merge_counts(plan) %></p>

    <% if local_assigns[:primary_case_url] %>
      <div class="merge-keep">
        <% plan.all.each do |kase| %>
          <%= link_to primary_case_url.call(kase), class: "merge-swap",
                data: { turbo_frame: "merge-body" },
                aria: { current: ("true" if kase.id == plan.primary.id) } do %>
            #<%= kase.id %> holds them
          <% end %>
        <% end %>
      </div>
    <% end %>
    <%= hidden_field_tag :duplicate_of, plan.primary.id, id: nil %>
  </div>

  <div class="merge-act">
    <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
    <%= submit_tag "Merge into ##{plan.primary.id}", class: "btn btn-primary" %>
  </div>
<% end %>
