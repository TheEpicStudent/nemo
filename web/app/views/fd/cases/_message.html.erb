<% grouped = local_assigns.fetch(:grouped, false) %>
<% forwarded_ids = Array(entry.shares).flat_map(&:file_ids) %>
<div id="message-<%= entry.key %>" class="msg <%= entry.side == "out" ? "out" : "in" %> <%= "is-grouped" if grouped %>"
     data-kind="<%= entry.kind %>">
  <%= entry.anon ? anonymous_face : avatar(entry.who) %>
  <div>
    <% if !grouped || entry.state %>
      <div class="msg-head">
        <% unless grouped %>
          <span class="msg-who"><%= named_text(entry.name) %></span>
          <span class="msg-at"><%= clock_stamp(entry.at, "%-d %b, %H:%M") %></span>
          <% if %w[them us].include?(entry.kind) %><span class="chip chip-sm chip-primary">reporter</span><% end %>
        <% end %>
        <% if entry.state %><span class="chip chip-sm <%= state_tone(entry.state) %>"><%= entry.state %></span><% end %>
      </div>
    <% end %>
    <% if entry.blocks.present? || entry.body.present? %>
      <div class="msg-body msg-rich"><%= body_html(entry) %></div>
    <% end %>
    <% if entry.shares.present? %>
      <div class="msg-cites">
        <% entry.shares.each do |cite| %>
          <figure class="cite <%= "cite-bare" unless cite.body? %>">
            <figcaption class="cite-head">
              <%= avatar(cite.source_author_user_id, css: "row-avatar cite-face") %>
              <span class="cite-who">
                <%= cite.source_author_user_id.present? ? handle(cite.source_author_user_id) : "Unknown" %>
              </span>
              <span class="cite-how">
                <%= cite.kind_label %><%= " from" if cite.source_channel_id.present? %>
              </span>
              <% if cite.source_channel_id.present? %>
                <%= channel_mention(cite.source_channel_id, cite.source_channel_name) %>
              <% end %>
              <% if cite.permalink.present? %>
                <%= link_to cite.permalink, class: "cite-open", target: "_blank", rel: "noopener",
                      aria: { label: "Open in Slack" } do %>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
                <% end %>
              <% end %>
            </figcaption>
            <% if cite.body? %>
              <blockquote class="cite-body"><%= mentioned(cite.source_body) %></blockquote>
            <% else %>
              <p class="cite-body none"><%= cite.why_not %></p>
            <% end %>
            <% cited_files = Array(entry.files).select { |file| cite.file_ids.include?(file.slack_file_id) } %>
            <% if cited_files.any? %>
              <div class="cite-files">
                <% cited_files.each do |file| %>
                  <%= render "fd/cases/message_file", file: file %>
                <% end %>
              </div>
            <% end %>
          </figure>
        <% end %>
      </div>
    <% end %>
    <% if Array(entry.files).any? { |file| !forwarded_ids.include?(file.slack_file_id) } %>
      <div class="msg-files">
        <% entry.files.reject { |file| forwarded_ids.include?(file.slack_file_id) }.each do |file| %>
          <%= render "fd/cases/message_file", file: file %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
