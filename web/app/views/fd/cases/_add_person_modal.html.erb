<%= render layout: "fd/modal", locals: { id: "add-person",
      title: "Add subject to case #{kase.id}", label: "Add subject" } do %>
  <%= form_with url: fd_case_participants_path(kase), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>Subject</span>
        <%= render "shared/combobox", name: "user_ids[]",
              url: fd_member_search_path(case_id: kase.id),
              label: "Search members" %>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Add", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
