<% denied = why_not("case.tag", kase) %>
<% remove_mark = capture do %>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
<% end %>
<div class="tagbar" role="group" aria-label="Tags">
  <%= render "fd/cases/tag_mark", css: "tag-mark" %>
  <% links.each do |link| %>
    <span class="pill">
      <span><%= link_to link.tag.name, fd_cases_path(tag: link.tag.name), class: "tag-link" %></span>
      <% unless denied %>
        <%= gated_button "case.tag", remove_mark, fd_case_tag_path(kase, link.tag_id), on: kase,
              method: :delete, css: "tag-x", aria: { label: "Remove #{link.tag.name}" } %>
      <% end %>
    </span>
  <% end %>
  <% if denied %>
    <%= dead_button("Add tag", denied, "btn btn-ghost btn-sm") %>
  <% else %>
    <%= form_with url: fd_case_tags_path(kase), method: :post, class: "contents",
          html: { autocomplete: "off" } do %>
      <%= render "shared/combobox", name: "name", kind: "tag", trigger: "Add tag",
            trigger_css: "btn btn-ghost btn-sm", url: fd_tag_search_path(case_id: kase.id),
            single: true, submit: true, least: 0, empty: "No tags found",
            label: "Find or create a tag", placeholder: "Find or create a tag" %>
    <% end %>
  <% end %>
</div>
