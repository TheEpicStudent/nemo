<%= render layout: "fd/modal", locals: { id: "open-case", title: "Open case",
      open: @open_modal } do %>
      <%= form_with url: fd_cases_path, method: :post, html: { autocomplete: "off" } do %>
        <div class="modal-body">
          <div class="field-label">
            <span>Subjects</span>
            <%= render "shared/combobox", name: "subject_user_ids[]",
                  label: "Search members", preset: @subject_preset %>
          </div>

          <div class="field-label">
            <span>Category</span>
            <%= render "shared/choice", name: :category_key, blank: "Not set",
                  chosen: (params[:category_key].present? ?
                    category_label(params[:category_key]) : "Not set"),
                  options: [{ value: "", label: "Not set",
                              current: params[:category_key].blank? }] +
                    Fd::InfractionCategory.active_keys.map { |key| {
                      value: key, label: category_label(key),
                      current: params[:category_key] == key } } %>
          </div>

          <label class="field-label">
            Description
            <%= render "fd/mention_field", name: :body, value: params[:body], rows: 4,
                  placeholder: nil, required: true,
                  maxlength: Fd::CaseChat::MAX_LENGTH %>
          </label>

          <label class="opt">
            <%= hidden_field_tag :assign_to_me, "0", id: nil %>
            <%= check_box_tag :assign_to_me, "1", params.fetch(:assign_to_me, "1") == "1",
                  class: "tick" %>
            <span>
              <span class="opt-label">Assign to me</span>
            </span>
          </label>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
          <%= submit_tag "Open case", class: "btn btn-primary" %>
        </div>
      <% end %>
<% end %>
