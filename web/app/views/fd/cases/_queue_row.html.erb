<% label = violations_label(violations[kase.id] || [kase.category_key].compact, short: true) %>
<% priors = case_priors(kase, priors_by_user) %>
<span class="queue-top">
  <%= row_reporter_face(kase) %>
  <span class="queue-id">#<%= kase.id %></span>
  <span class="queue-by trunc"><%= row_reporter_label(kase) %></span>
  <span class="queue-age <%= age_ink(case_age_seconds(kase)) unless kase.resolved? %>">
    <%= kase.resolved? ? "closed" : case_age_label(case_age_seconds(kase)) %>
  </span>
</span>

<% cited = case_cited(kase) %>
<% if cited %>
  <span class="queue-cite">
    <span class="queue-cite-head">
      <%= avatar(cited.author, css: "row-avatar queue-cite-face") %>
      <span class="queue-cite-who trunc"><%= names[cited.author] %></span>
      <% has_channel_name = cited.channel.present? && channels.named?(cited.channel) %>
      <span class="queue-cite-how"><%= cited.kind_label %><%= " from" if has_channel_name %></span>
      <% if has_channel_name %>
        <span class="queue-cite-in trunc"><%= channels[cited.channel] %></span>
      <% end %>
    </span>
    <span class="queue-cite-body"><%= plain_text(cited.body) %></span>
  </span>
<% else %>
  <span class="queue-subject"><%= case_words(kase) %></span>
<% end %>

<% tag_names = kase.case_tags.map { |link| link.tag.name } %>
<span class="queue-meta">
  <span class="queue-violation trunc"><%= label || "no violation set" %></span>
  <% if tag_names.any? %>
    <span class="queue-tags" title="<%= tag_names.join(", ") %>">
      <%= render "fd/cases/tag_mark", css: "tag-mark" %>
      <span class="visually-hidden">Tags</span>
      <span class="trunc"><%= tag_names.first %></span>
      <% if tag_names.size > 1 %><span class="queue-tags-more">+<%= tag_names.size - 1 %></span><% end %>
    </span>
  <% end %>
  <% if kase.assigned? %>
    <span class="avatar-stack">
      <%= safe_join(kase.assignee_user_ids.map { |id| avatar(id) }) %>
    </span>
  <% end %>
</span>
