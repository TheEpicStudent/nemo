<div class="list thread-guard-list">
  <% guards.each do |guard| %>
    <div class="lrow <%= "is-reversed" unless guard.active? %>">
      <span class="evdot <%= guard.failed? ? "crit" : "act" %>" aria-hidden="true">
        <%= case_action_button("act", nil) %>
      </span>
      <span class="grow">
        <span class="lrow-head">
          <b><%= thread_guard_line(guard) %></b>
          <%= thread_guard_chip(guard) %>
        </span>
        <span class="sub"><%= guard.reason %></span>
        <% if guard.locking? && guard.active? %>
          <span class="sub"><%= time_left_label(guard.expires_at) %></span>
        <% end %>
        <% if guard.note_text.present? %>
          <span class="lcite"><%= guard.note_text %></span>
        <% end %>
        <span class="sub">
          <%= member_link(guard.opened_by) %> ·
          <%= clock_stamp(guard.created_at) %>
        </span>
      </span>
      <span class="lrow-right">
        <% if guard.locking? && guard.active? %>
          <%= opens_modal "thread.guard", "Extend", opens: "lock-extend-#{guard.id}", css: "btn btn-sm" %>
          <%= gated_button("thread.guard", "Unlock", fd_case_thread_lock_path(kase, guard),
                css: "btn btn-sm btn-danger", method: :delete) %>
        <% end %>
        <%= open_in_slack slack_thread_url(guard.channel_id, guard.thread_ts), css: "btn btn-sm" %>
      </span>
    </div>
  <% end %>
</div>

<% guards.select { |guard| guard.locking? && guard.active? }.each do |guard| %>
  <%= render layout: "fd/modal", locals: { id: "lock-extend-#{guard.id}", title: "Extend lock" } do %>
    <%= form_with url: fd_case_thread_lock_path(kase, guard), method: :patch, html: { autocomplete: "off" } do %>
      <div class="modal-body">
        <%= render "fd/end_fields", label: "New end (UTC)", required: true, current: guard.expires_at %>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Extend", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
