<% current = local_assigns[:current]&.utc %>
<div class="field-label">
  <span><%= label %></span>
  <span class="field-pair">
    <%= date_field_tag :expires_on, current&.to_date&.iso8601, class: "input", id: nil,
          aria: { label: "End date" }, required: local_assigns[:required] %>
    <%= time_field_tag :expires_time, current&.strftime("%H:%M"), class: "input", id: nil,
          aria: { label: "End time (UTC)" } %>
  </span>
</div>
