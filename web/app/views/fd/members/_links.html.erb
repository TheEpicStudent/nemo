<%= turbo_frame_tag "member-links-#{user_id}", target: "_top" do %>
<div class="pane-body">
  <% if links.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr><th>Account</th><th>Score</th><th>Evidence</th><th>Last seen</th><th>Verdict</th></tr>
        </thead>
        <tbody>
          <% links.each do |link| %>
            <tr>
              <td><%= member_face(link.other_id) %></td>
              <td><%= link_band_chip(link) %>
                <span class="sub2"><%= number_with_precision(link.score, precision: 1) %></span>
              </td>
              <td class="link-why">
                <% link.evidence.each do |evidence_item| %>
                  <div class="sub2">
                    <%= evidence_item["label"] %>
                    <span class="mono"><%= evidence_item["value"] %></span>
                    <%= "shared with #{evidence_item['people']}" if evidence_item["people"].to_i > 2 %>
                  </div>
                <% end %>
              </td>
              <td class="sub2"><%= link.last_seen ? on_day(link.last_seen) : "n/a" %></td>
              <% verdict = Fd::LinkVerdict.of(verdicts, user_id, link.other_id) %>
              <td><%= verdict_cell(user_id, link.other_id, verdict, back: fd_member_path(user_id, tab: "links")) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if cluster_members.any? %>
    <% deactivated_count = cluster_members.count { |_, active| !active } %>
    <section class="link-mates">
      <div class="link-mates-head">
        <h3 class="link-mates-title">Cluster</h3>
        <span class="sub2">
          <%= pluralize(number_with_delimiter(cluster_members.size), "other account") %><%= ", #{number_with_delimiter(deactivated_count)} deactivated" if deactivated_count.positive? %>
        </span>
        <%= link_to "Open cluster", fd_cluster_path(cluster_of), class: "btn btn-sm link-mates-open" if cluster_of %>
      </div>
      <div class="facepile">
        <% cluster_members.first(Fd::MemberLink::CLUSTER_MEMBER_LIMIT).each do |member_user_id, active| %>
          <%= link_to fd_member_path(member_user_id), class: ["facepile-face", ("is-gone" unless active)],
                title: active ? names[member_user_id] : "#{names[member_user_id]}, deactivated",
                aria: { label: names[member_user_id] }, data: { turbo_frame: "person-drawer" } do %>
            <%= avatar(member_user_id, css: "facepile-img") %>
          <% end %>
        <% end %>
        <% if cluster_members.size > Fd::MemberLink::CLUSTER_MEMBER_LIMIT %>
          <span class="facepile-more">+<%= number_with_delimiter(cluster_members.size - Fd::MemberLink::CLUSTER_MEMBER_LIMIT) %></span>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if cluster_of && cluster_members.none? %>
    <div class="pane-foot">
      <%= link_to "Open cluster", fd_cluster_path(cluster_of), class: "btn btn-sm" %>
    </div>
  <% end %>

  <% if links.none? && cluster_members.none? %>
    <div class="empty">
      <p class="empty-title">No linked accounts</p>
    </div>
  <% end %>
</div>
<% end %>
