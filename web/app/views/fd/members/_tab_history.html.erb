<% if @entries.any? %>
  <div class="member-timeline">
    <% history_by_month(@entries).each do |month, entries| %>
      <p class="record-month"><%= month.strftime("%B %Y") %></p>
      <div class="list">
        <% entries.each do |entry| %>
          <% event_icon = entry.kind == "cases" ? "shield" : entry.kind == "actions" ? "gauge" : "note" %>
          <% event_tone = entry.word == "reversal" ? "good" : entry.kind == "actions" ? "warn" : entry.state == "open" ? "crit" : "" %>
          <div class="evrow<%= " is-reversed" if entry.state == "reversed" && entry.word != "reversal" %>">
            <span class="evdot <%= event_tone %>"><%= case_action_icon(event_icon) %></span>
            <div>
              <div class="member-event-head">
                <% if entry.case_id %>
                  <b><%= link_to entry.title, fd_case_path(entry.case_id) %></b>
                <% else %>
                  <b><%= entry.title %></b>
                <% end %>
              </div>
              <% if entry.body.present? %>
                <p class="member-event-body"><%= mentioned(entry.body) %></p>
              <% else %>
                <% event_detail = [entry.state, entry.detail].reject(&:blank?).join(" · ") %>
                <% if event_detail.present? %><p class="member-event-body"><%= named_text(event_detail) %></p><% end %>
              <% end %>
              <span class="member-event-by">
                <%= entry.who ? member_face(entry.who) : "n/a" %>
              </span>
            </div>
            <span class="evrow-right">
              <span class="evwhen"><%= entry.at.strftime("%-d %b") %></span>
              <% if entry.ref.is_a?(Fd::Note) %>
                <%= render "note_remove", user_id: @user_id, note: entry.ref %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty"><p class="empty-title">No history</p></div>
<% end %>
