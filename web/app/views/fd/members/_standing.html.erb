<%= turbo_frame_tag Fd::MemberGuardBroadcast.frame(user_id), target: "_top",
      data: { src: fd_member_standing_path(user_id) } do %>
  <% if guards.any? %>
    <div class="standing">
      <p class="standing-t">Guards <span class="standing-count"><%= guards.size %></span></p>
      <% guards.each do |guard| %>
        <% may_lift = (guard.deactivation? ? may_deactivate : may_guard) && !guard.firehose? %>
        <div class="standing-row<%= " is-enforced" if guard.deactivation? %>"
             <%= tag.attributes(data: {
                   controller: ("deactivate" if guard.deactivation?),
                   enforcement_status: (guard.enforcement_state if guard.deactivation?),
                   landed: (guard.recently_updated?.to_s if guard.deactivation?)
                 }.compact) %>>
          <span class="evdot <%= guard_dot_tone(guard) %>">
            <%= case_action_icon("gauge") %>
          </span>
          <span class="grow standing-line">
            <b><%= guard_line(guard) %></b>
            <span class="sub"><%= guard_footnote(guard, names) %></span>
            <% if guard.deactivation? %>
              <span class="enforcement-state"><%= guard_enforcement_label(guard) %></span>
              <span class="enforcement-slow" data-deactivate-target="slow" hidden>
                Awaiting Slack
              </span>
              <% if guard.failed? && guard.last_error.present? %>
                <span class="enforcement-why"><%= guard.last_error %></span>
              <% end %>
            <% end %>
          </span>
          <span class="standing-do">
            <% if guard.case_id %>
              <%= link_to "Case ##{guard.case_id}", fd_case_path(guard.case_id),
                    class: "btn btn-sm btn-ghost" %>
            <% end %>
            <% if may_lift %>
              <button type="button" class="btn btn-sm" aria-haspopup="dialog"
                      data-modal-open="guard-lift-<%= guard.id %>">
                <%= guard.deactivation? ? "Reactivate" : "Lift" %>
              </button>
            <% end %>
          </span>
        </div>

        <% if may_lift %>
          <%= render layout: "fd/modal", locals: {
                id: "guard-lift-#{guard.id}",
                title: guard.deactivation? ? "Reactivate" : "Lift",
                sub: names[user_id], open: false } do %>
            <%= form_with url: fd_member_guard_path(user_id, guard), method: :delete,
                  html: { autocomplete: "off" } do %>
              <div class="modal-body">
                <% unless guard.deactivation? %>
                <% end %>
                <label class="field-label">
                  Reason
                  <%= text_area_tag :lift_reason, nil, rows: 3, class: "textarea", id: nil %>
                </label>
              </div>
              <div class="modal-foot">
                <button type="button" class="btn btn-ghost"
                        data-action="click->modal#close">Cancel</button>
                <%= submit_tag guard.deactivation? ? "Reactivate" : "Lift",
                      class: "btn btn-danger" %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
