<% name = @channel&.name.presence %>
<% label = name ? "##{name}" : @purge.channel_id %>
<% everywhere = @purge.channel_id.nil? %>
<% content_for :page_title, "Purged from #{everywhere ? names[@purge.member_id] : label}" %>
<% content_for :head_context do %>
  <span class="triad-sep">&middot;</span>
  <span class="triad-who"><%= purge_state_chip(@purge) %></span>
<% end %>
<% content_for :head_actions do %>
  <% if everywhere %>
    <%= link_to "Member", fd_member_path(@purge.member_id, tab: "purges"),
          class: "btn btn-ghost" %>
  <% else %>
    <%= link_to "Channel", fd_channel_path(@purge.channel_id, tab: "purge"),
          class: "btn btn-ghost" %>
  <% end %>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">
      <%= purge_scope(@purge) %>
      <% if @purge.member_id %>
        from <%= member_link(@purge.member_id) %>
      <% end %>
      <% if everywhere %>
        in every channel
      <% end %>
    </h2>
    <p class="card-note">
      requested by <%= member_link(@purge.asked_by) %> &middot; <%= at_minute(@purge.asked_at) %>
      <% if purge_source(@purge) %>
        &middot; <%= purge_source(@purge) %>
      <% end %>
      &middot; <%= purge_progress(@purge) %>
    </p>
  </div>
  <% if @purge.reason.present? || @purge.error.present? %>
    <div class="card-body">
      <% if @purge.reason.present? %>
        <p class="msg-body"><%= @purge.reason %></p>
      <% end %>
      <% if @purge.error.present? %>
        <p class="sub2"><%= @purge.error %></p>
      <% end %>
    </div>
  <% end %>
</div>

<% if @failed.any? %>
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Failed</h2>
    </div>
    <div class="card-body">
      <% @failed.each do |message, error| %>
        <%= render "fd/channel_purges/message", message: message, names: @names, show_channel: everywhere %>
        <p class="sub2"><%= error %></p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Purged</h2>
  </div>

  <% if @threads.any? %>
    <div class="card-body">
      <% @threads.top_level.each do |message| %>
        <%= render "fd/channel_purges/message", message: message, names: @names, show_channel: everywhere %>
        <% below = @threads.below(message) %>
        <% if below.any? %>
          <details class="purge-thread">
            <summary><%= pluralize(below.size, "reply") %></summary>
            <% below.each do |reply| %>
              <%= render "fd/channel_purges/message", message: reply, names: @names, show_channel: everywhere %>
            <% end %>
          </details>
        <% end %>
      <% end %>

      <% if @threads.orphans.any? %>
        <details class="purge-thread">
          <summary><%= pluralize(@threads.orphans.size, "reply") %> &middot; parent not purged</summary>
          <% @threads.orphans.each do |message| %>
            <%= render "fd/channel_purges/message", message: message, names: @names, show_channel: everywhere %>
          <% end %>
        </details>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No messages</p>
    </div>
  <% end %>
</div>
