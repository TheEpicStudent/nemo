<% name = @channel&.name.presence %>
<% label = name ? "##{name}" : @purge.channel_id %>
<% content_for :page_title, "Purged from #{label}" %>
<% content_for :head_context do %>
  <span class="triad-sep">&middot;</span>
  <span class="triad-who"><%= purge_state_chip(@purge) %></span>
<% end %>
<% content_for :head_actions do %>
  <%= link_to "Back to the channel", fd_channel_path(@purge.channel_id, tab: "purge"),
        class: "btn btn-ghost" %>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">
      <%= purge_scope(@purge) %>
      <% if @purge.member_id %>
        from <%= member_face(@purge.member_id, small: true) %>
      <% end %>
    </h2>
    <p class="card-note">
      asked by <%= member_face(@purge.asked_by, small: true) %> &middot; <%= at_minute(@purge.asked_at) %>
      <% if purge_source(@purge) %>
        &middot; <%= purge_source(@purge) %>
      <% end %>
      &middot; <%= purge_progress(@purge) %>
    </p>
  </div>
  <% if @purge.reason.present? || @purge.error.present? %>
    <div class="card-body">
      <% if @purge.reason.present? %>
        <p class="msg-body"><%= @purge.reason %></p>
      <% end %>
      <% if @purge.error.present? %>
        <p class="sub2"><%= @purge.error %></p>
      <% end %>
    </div>
  <% end %>
</div>

<% if @failed.any? %>
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Could not be deleted</h2>
    </div>
    <div class="card-body">
      <% @failed.each do |message, error| %>
        <%= render "message", message: message, names: @names %>
        <p class="sub2"><%= error %></p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Purged</h2>
  </div>

  <% if @threads.any? %>
    <div class="card-body">
      <% @threads.top_level.each do |message| %>
        <%= render "message", message: message, names: @names %>
        <% below = @threads.below(message) %>
        <% if below.any? %>
          <details class="purge-thread">
            <summary><%= pluralize(below.size, "reply") %></summary>
            <% below.each do |reply| %>
              <%= render "message", message: reply, names: @names %>
            <% end %>
          </details>
        <% end %>
      <% end %>

      <% if @threads.orphans.any? %>
        <details class="purge-thread">
          <summary><%= pluralize(@threads.orphans.size, "reply") %>, the top was not purged</summary>
          <% @threads.orphans.each do |message| %>
            <%= render "message", message: message, names: @names %>
          <% end %>
        </details>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">Nothing kept</p>
    </div>
  <% end %>
</div>
