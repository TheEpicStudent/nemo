<div class="card-tools">
  <details class="menu" data-controller="menu">
    <summary class="btn" aria-label="<%= said %>">
      <%= chosen %><span class="car" aria-hidden="true">&#9662;</span>
    </summary>
    <div class="menu-pop menu-compact">
      <% groups.each_with_index do |group, at| %>
        <% next if group[:options].blank? %>
        <% if at.positive? %><div class="menu-sep"></div><% end %>
        <% if group[:title] %><p class="menu-group"><%= group[:title] %></p><% end %>
        <% group[:options].each do |option| %>
          <%= link_to option[:label], option[:href], class: "btn",
                aria: { current: ("true" if option[:current]) } %>
        <% end %>
      <% end %>
    </div>
  </details>
</div>
