<% rank = channel_standing(standing) %>
<dl class="facts-strip channel-facts">
  <div class="fact">
    <dt>created</dt>
    <dd>
      <% if channel.date_created %>
        <%= channel.date_created.to_date.strftime("%-d %b %Y") %>
      <% else %>
        <span class="sub2">n/a</span>
      <% end %>
    </dd>
  </div>
  <div class="fact">
    <dt>members</dt>
    <dd><%= snapshot&.total_members ? number_with_delimiter(snapshot.total_members) : "n/a" %></dd>
  </div>
  <div class="fact">
    <dt>people who spoke</dt>
    <dd>
      <% if crowd.any? %>
        <%= number_with_delimiter(crowd.posters) %>
      <% else %>
        <span class="sub2">n/a</span>
      <% end %>
    </dd>
  </div>
  <div class="fact">
    <dt>busiest rank</dt>
    <dd>
      <% if rank %>
        #<%= number_with_delimiter(rank[:rank]) %>
        <span class="short">of <%= number_with_delimiter(rank[:of]) %></span>
      <% else %>
        <span class="sub2">n/a</span>
      <% end %>
    </dd>
  </div>
  <div class="fact">
    <dt>share of workspace</dt>
    <dd>
      <% if standing&.share_of_total %>
        <%= number_to_percentage(standing.share_of_total.to_f, precision: 2) %>
      <% else %>
        <span class="sub2">n/a</span>
      <% end %>
    </dd>
  </div>
  <div class="fact">
    <dt>last post</dt>
    <dd>
      <% seen = said_ago(snapshot&.last_message_at || channel.last_active_at) %>
      <%= seen || tag.span("n/a", class: "sub2") %>
    </dd>
  </div>
</dl>
