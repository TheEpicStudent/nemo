<% content_for :page_title, "##{@channel.name}" %>
<% content_for :page_face do %>
  <span class="crumb"><%= link_to "Channels", channels_path %> /</span>
<% end %>

<% content_for :head_actions do %>
  <% if ChannelsController::RANGED_VIEWS.include?(@view) %>
    <%= render "shared/date_range", url: channel_path(@channel),
          start_on: @start_date, end_on: @end_date, min: @range_min, max: @range_max,
          hidden_params: { view: @view }.compact,
          presets: ChannelsController::RANGE_PRESETS.map { |days| {
            label: "Last #{days} days", current: @range_preset == days,
            href: channel_view_path(days: days) } } %>
  <% end %>
  <%= open_in_slack slack_channel_url(@channel.channel_id) %>
  <%= render "backfill_button", channel: @channel, backfill: @backfill %>
<% end %>

<% content_for :page_tabs do %>
  <% @views.each do |key, label| %>
    <%= link_to label, channel_view_path(view: key), class: "view",
          aria: { current: ("true" if @view == key) } %>
  <% end %>
<% end %>

<div class="stack">
  <%= render "identity", channel: @channel, snapshot: @snapshot, standing: @standing,
        member_counts: @member_counts, team_stats: @team_stats %>

  <% case @view %>
  <% when "overview" %>
    <%= render "activity", pulse: @pulse, member_counts: @member_counts, clock: @clock,
          range: @range, start_date: @start_date, end_date: @end_date %>
  <% when "activity" %>
    <%= render "participants", member_counts: @member_counts, snapshot: @snapshot, channel: @channel %>
  <% when "newcomers" %>
    <%= render "welcome", welcome: @welcome, scorecard_rows: @scorecard_rows %>
  <% when "messages" %>
    <%= render "conversation", pulse: @pulse, start_date: @start_date, end_date: @end_date %>
  <% when "posts" %>
    <%= render "posts", posts: @posts, names: @names, mentioned_channels: @mentioned_channels, emoji: @emoji %>
  <% when "neighbours" %>
    <%= render "context", neighbours: @neighbours %>
  <% end %>
</div>


