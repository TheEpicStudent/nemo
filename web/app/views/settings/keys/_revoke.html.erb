<%= render layout: "fd/modal", locals: { id: "kill-#{token.id}",
      title: "Revoke #{token.name}?" } do %>
  <%= form_with url: settings_token_path(token), method: :delete do %>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Revoke", class: "btn btn-crit" %>
    </div>
  <% end %>
<% end %>
