<% content_for :page_title, "Access requests" %>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Requests</h2>
      <p class="card-sub"><%= @pending_count %> waiting</p>
    </div>
  </div>

  <% if @rows.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>App</th>
            <th>Owner</th>
            <th>State</th>
            <th>By</th>
            <th class="col-date">Date</th>
            <th class="col-btn"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |access_request| %>
            <tr>
              <td>
                <span class="row-name">
                  <%= avatar(access_request.app.owner_user_id) %>
                  <b><%= access_request.app.name %></b>
                </span>
              </td>
              <td class="sub"><%= person_name(access_request.app.owner_user_id) %></td>
              <td><%= access_state_chip(access_request.state) %></td>
              <td class="sub"><%= access_request.decided_by ? person_name(access_request.decided_by) : "" %></td>
              <td class="col-date">
                <%= time_ago_in_words(access_request.decided_at || access_request.created_at) %> ago
              </td>
              <td class="col-btn">
                <% if access_request.pending? %>
                  <button type="button" class="btn btn-sm" data-modal-open="settle-<%= access_request.id %>" aria-haspopup="dialog">Review</button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No requests</p>
    </div>
  <% end %>
</div>

<% @rows.select(&:pending?).each do |access_request| %>
  <%= render "settings/requests/settle", access_request: access_request %>
<% end %>
