<header class="landing-nav" data-controller="nav">
  <div class="landing-nav-inner">
    <%= link_to root_path, class: "landing-brand" do %>
      <%= image_tag "nemo.png", alt: "", width: 800, height: 483, class: "landing-brand-fish" %>
      <span>Nemo</span>
    <% end %>
    <nav class="landing-nav-links" aria-label="Sections">
      <% LandingHelper::NAV_LINKS.each do |label, href| %>
        <%= link_to label, href, class: "landing-nav-link" %>
      <% end %>
    </nav>
    <div class="landing-nav-end">
      <%= link_to LandingHelper::REPOSITORY_URL, class: "landing-nav-link landing-nav-github" do %>
        <%= github_mark %><span>GitHub</span>
      <% end %>
      <%= render "landing/sign_in", label: "Sign in", button_class: "landing-btn landing-btn-accent landing-btn-sm" %>
    </div>
  </div>
</header>

<main>
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-head">
      <h1 id="landing-title" class="landing-headline" <%= tag.attributes(data: effect_data("split_text", LandingHelper::HEADLINE_EFFECT)) %>>Community analytics and conduct casework for Hack Club.</h1>
      <div class="landing-actions">
        <%= render "landing/sign_in", label: "Sign in with Hack Club Auth", button_class: "landing-btn landing-btn-primary", mark: true, arrow: true, form_data: effect_data("magnet", LandingHelper::MAGNET_EFFECT) %>
        <%= link_to LandingHelper::REPOSITORY_URL, class: "landing-btn landing-btn-quiet" do %>
          <%= github_mark %><span>Source on GitHub</span>
        <% end %>
      </div>
    </div>

    <div class="landing-stage" data-controller="commands">
      <div class="landing-stage-ground" aria-hidden="true" <%= tag.attributes(data: effect_data("gradient_waves", LandingHelper::WAVES_EFFECT)) %>></div>

      <div class="landing-window landing-window-case" role="img" aria-label="Fire Engine case view">
        <div class="landing-window-bar">Fire Engine</div>
        <div class="landing-window-body">
          <p class="landing-case-head"><span class="landing-case-number">#16</span>advertising</p>
          <div class="landing-case-tabs" aria-hidden="true">
            <% LandingHelper::CASE_TABS.each_with_index do |(label, count), index| %>
              <span class="landing-case-tab<%= " is-current" if index.zero? %>"><%= label %> <b><%= count %></b></span>
            <% end %>
          </div>
          <ol class="landing-case-thread">
            <% LandingHelper::CASE_MESSAGES.each do |message| %>
              <li class="landing-message<%= " is-internal" unless message[:role] %>">
                <span class="landing-face landing-face-<%= message[:tint] %>"><%= message[:name].first.upcase %></span>
                <div>
                  <p class="landing-message-meta">
                    <b><%= message[:name] %></b>
                    <span><%= message[:time] %></span>
                    <% if message[:role] %><span class="landing-message-role"><%= message[:role] %></span><% end %>
                  </p>
                  <p class="landing-message-text"><%= message[:text] %></p>
                </div>
              </li>
            <% end %>
          </ol>
        </div>
      </div>

      <div class="landing-window landing-window-slack" aria-hidden="true">
        <div class="landing-window-bar">#lounge</div>
        <ul class="landing-commands">
          <% LandingHelper::NEMO_COMMANDS.each_with_index do |command, index| %>
            <li class="landing-command<%= " is-current" if index.zero? %>" data-commands-target="command" data-example="<%= command[:example] %>">
              <span class="landing-command-name">/nemo <%= command[:name] %></span>
              <span class="landing-command-usage"><%= command[:usage] %></span>
            </li>
          <% end %>
        </ul>
        <div class="landing-composer">
          <span data-commands-target="composer"><%= LandingHelper::NEMO_COMMANDS.first[:example] %></span>
        </div>
      </div>

    </div>
  </section>

  <section id="features" class="landing-section" aria-labelledby="landing-features">
    <h2 id="landing-features" class="landing-heading">Features</h2>
    <div class="landing-bento">
      <article class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well landing-well-bleed">
          <% [["left", LandingHelper::ACTION_LABELS], ["right", LandingHelper::ACTION_LABELS.reverse]].each do |direction, row| %>
            <div class="landing-marquee-row" <%= tag.attributes(data: effect_data("logo_loop", LandingHelper::ACTION_LOOP.merge(direction: direction))) %>>
              <% row.each do |label| %><span class="landing-chip"><%= label %></span><% end %>
            </div>
          <% end %>
        </div>
        <h3 class="landing-card-title">Fire Engine</h3>
        <p class="landing-card-text">Cases, reports, mirrored threads, notes, actions and reversals</p>
      </article>

      <article class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well" aria-hidden="true">
          <p class="landing-well-head"><span>Active, last 28 days</span><b>416</b></p>
          <svg class="landing-area" viewBox="0 0 <%= LandingHelper::AREA_W %> <%= LandingHelper::AREA_H %>" preserveAspectRatio="none">
            <defs>
              <linearGradient id="landing-area-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="currentColor" stop-opacity="0.28"></stop>
                <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="<%= landing_area_path(LandingHelper::ACTIVE_SERIES, closed: true) %>" fill="url(#landing-area-fill)"></path>
            <path class="landing-area-line" d="<%= landing_area_path(LandingHelper::ACTIVE_SERIES) %>"></path>
          </svg>
          <p class="landing-well-foot"><span>Sep 23</span><span>Oct 5</span><span>Oct 17</span></p>
        </div>
        <h3 class="landing-card-title">Community analytics</h3>
        <p class="landing-card-text">Joining, replies, retention, activity and channels</p>
      </article>

      <article class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well" aria-hidden="true">
          <ul class="landing-menu">
            <% LandingHelper::SLACK_SHORTCUTS.each_with_index do |shortcut, index| %>
              <li class="landing-menu-row<%= " is-current" if index == 1 %>"><%= landing_icon(shortcut[:icon], size: 15) %><span><%= shortcut[:label] %></span></li>
            <% end %>
          </ul>
        </div>
        <h3 class="landing-card-title">Slack bot</h3>
        <p class="landing-card-text">Report shortcuts, thread shortcuts and /nemo</p>
      </article>

      <article class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well" aria-hidden="true">
          <p class="landing-well-head"><span class="landing-well-who"><span class="landing-face landing-face-3">W</span>wren92</span><span>4 accounts</span></p>
          <svg class="landing-cluster" viewBox="0 0 120 64">
            <% LandingHelper::CLUSTER_LINKS.each do |from, to| %>
              <% a = LandingHelper::CLUSTER_NODES[from] %><% b = LandingHelper::CLUSTER_NODES[to] %>
              <line x1="<%= a[0] %>" y1="<%= a[1] %>" x2="<%= b[0] %>" y2="<%= b[1] %>"></line>
            <% end %>
            <% LandingHelper::CLUSTER_NODES.each do |x, y, deactivated| %>
              <circle cx="<%= x %>" cy="<%= y %>" r="4" class="<%= "is-deactivated" if deactivated %>"></circle>
            <% end %>
          </svg>
          <p class="landing-well-foot"><span>3 active</span><span>1 deactivated</span><span>Top signal: ip</span></p>
        </div>
        <h3 class="landing-card-title">Alt account detection</h3>
        <p class="landing-card-text">Links, clusters and a review queue</p>
      </article>

      <article class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well" aria-hidden="true">
          <ol class="landing-audit">
            <% LandingHelper::AUDIT_ROWS.each do |time, actor, label| %>
              <li><span class="landing-audit-time"><%= time %></span><b><%= actor %></b><span><%= label %></span></li>
            <% end %>
          </ol>
        </div>
        <h3 class="landing-card-title">Audit log</h3>
        <p class="landing-card-text">Saved queries and CSV export</p>
      </article>

      <article id="api" class="landing-card" <%= tag.attributes(data: effect_data("spotlight_card", LandingHelper::SPOTLIGHT_EFFECT)) %>>
        <div class="landing-well">
          <pre class="landing-code"><code><span class="landing-code-verb">GET</span> <%= LandingHelper::API_REQUEST.delete_prefix("GET ") %>
<span class="landing-code-status">200</span> {
  <span class="landing-code-key">"consent"</span>: "granted",
  <span class="landing-code-key">"is_manager"</span>: true,
  <span class="landing-code-key">"stale"</span>: false
}</code></pre>
        </div>
        <h3 class="landing-card-title">Public API</h3>
        <p class="landing-card-text">Channel manager check, per-app consent and rate limits</p>
      </article>
    </div>
  </section>

  <section id="in-the-app" class="landing-section" aria-labelledby="landing-in-the-app" data-controller="tour">
    <div class="landing-section-head">
      <h2 id="landing-in-the-app" class="landing-heading">In the app</h2>
      <div class="landing-tabs" role="tablist" aria-label="Screens">
        <% LandingHelper::GALLERY.each_with_index do |shot, index| %>
          <button type="button" role="tab" id="landing-tab-<%= index %>" class="landing-tab" aria-selected="<%= index.zero? %>" aria-controls="landing-shot-<%= index %>" data-tour-target="tab" data-action="tour#select"><%= shot[:label] %></button>
        <% end %>
      </div>
    </div>
    <div class="landing-tour">
      <% LandingHelper::GALLERY.each_with_index do |shot, index| %>
        <div id="landing-shot-<%= index %>" class="landing-tour-shot<%= " is-current" if index.zero? %>" role="tabpanel" aria-labelledby="landing-tab-<%= index %>" data-tour-target="shot">
          <%= landing_capture(shot[:capture], shot[:label]) %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="landing-section" aria-labelledby="landing-close-title">
    <div class="landing-band">
      <div class="landing-band-ground" aria-hidden="true" <%= tag.attributes(data: effect_data("light_rays", LandingHelper::RAYS_EFFECT)) %>></div>
      <h2 id="landing-close-title" class="landing-band-title">Nemo</h2>
      <div class="landing-actions">
        <%= render "landing/sign_in", label: "Sign in with Hack Club Auth", button_class: "landing-btn landing-btn-primary", mark: true, arrow: true %>
      </div>
    </div>
  </section>
</main>

<footer class="landing-foot">
  <div class="landing-foot-inner">
    <p class="landing-foot-meta">
      <%= image_tag "nemo.png", alt: "", width: 800, height: 483, class: "landing-brand-fish", loading: "lazy" %>
      <span>Mnemosyne</span><span>MIT license</span>
    </p>
    <nav class="landing-foot-links" aria-label="Footer">
      <%= link_to "Hack Club", LandingHelper::HACK_CLUB_URL %>
      <%= link_to "GitHub", LandingHelper::REPOSITORY_URL %>
    </nav>
  </div>
</footer>
