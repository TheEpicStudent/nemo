<% content_for :page_title, "Channels" %>

<% content_for :page_controls do %>
  <%= form_with url: admin_channels_path, method: :get, class: "queue-search",
        data: { controller: "live-search", turbo_frame: "admin-channels",
                turbo_action: "advance" } do %>
    <%= search_field_tag :q, @q, placeholder: "Search by name",
          class: "queue-search-input", autocomplete: "off", aria: { label: "Search channels" },
          data: { action: "input->live-search#go" } %>
  <% end %>
  <% if @q.present? %>
    <%= link_to "Clear", admin_channels_path, class: "btn",
          data: { turbo_frame: "admin-channels" } %>
  <% end %>
<% end %>

<turbo-frame id="admin-channels" target="_top">
  <section class="section">
    <div class="section-head">
      <h2 class="section-title"><%= @q.present? ? "Matching" : "Directory" %></h2>
      <p class="section-note">
        <% if @q.present? %>
          &ldquo;<%= @q %>&rdquo;
        <% else %>
          <%= number_with_delimiter(@total) %> channels &middot; <%= number_with_delimiter(@open) %> public
        <% end %>
      </p>
    </div>

    <% if @bands.any? %>
      <div class="card card-flush">
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Channel</th><th>Audience</th><th>Grants</th>
                <th>Last active</th><th class="col-btn"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @bands.each do |kind, label, channels| %>
                <tr class="band-row">
                  <td colspan="5"><%= label %> &middot; <%= channels.size %></td>
                </tr>
                <% channels.each do |channel| %>
                  <% channel_grants = @grants[channel.channel_id] || [] %>
                  <tr>
                    <td>
                      <span class="two-line">
                        <%= link_to "##{channel.name}", channel_path(channel.channel_id) %>
                        <span class="mono"><%= channel.channel_id %></span>
                      </span>
                    </td>
                    <td>
                      <%= audience_chip(kind) %>
                      <% if @activity.include?(channel.channel_id) %>
                        <span class="chip chip-good">Activity</span>
                      <% end %>
                    </td>
                    <td><%= grant_faces(channel_grants, kind) %></td>
                    <td class="<%= "sub" unless channel.last_active_at %>"><%= ago_label(channel.last_active_at, none: "Never") %></td>
                    <td class="col-btn">
                      <%= render "admin/channels/row_menu", channel: channel, kind: kind,
                            named: channel_grants %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">
          <%= @q.present? ? "No channel matches" : "No channels" %>
        </p>
      </div>
    <% end %>
  </section>
</turbo-frame>
