<% if may_community?("analytics.channel.share") %>
  <%= render layout: "shared/dropdown", locals: {
        label: "Audience for ##{channel.name}", trigger: menu_dots } do %>
      <% Channels::Audience::KINDS.each do |audience| %>
        <%= button_to admin_channel_path(channel.channel_id), method: :patch,
              params: { audience: audience, q: @q.presence }, class: "btn",
              aria: { current: ("true" if audience == kind) } do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= audience.capitalize %></span>
            <span class="menu-item-note"><%= AdminHelper::AUDIENCE_NOTE.fetch(audience) %></span>
          </span>
        <% end %>
      <% end %>
      <div class="menu-sep"></div>
      <% Admin::RoleChannelsController::SHARED_ROLES.each do |role| %>
        <% in_set = named.any? { |grant| grant.role == role } %>
        <%= button_to admin_role_channels_path,
              method: in_set ? :delete : :post,
              params: { role: role, channel_id: channel.channel_id,
                        from: "channels", q: @q.presence },
              class: "btn" do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= in_set ? "Remove from" : "Add to" %>
              <%= role_label_text(role) %> set</span>
          </span>
        <% end %>
      <% end %>
      <% if may_community?("analytics.message.show") %>
        <div class="menu-sep"></div>
        <% activity_enabled = @activity.include?(channel.channel_id) %>
        <%= button_to activity_admin_channel_path(channel.channel_id), method: :patch,
              params: { shown: activity_enabled ? "off" : "on", q: @q.presence }, class: "btn" do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= activity_enabled ? "Hide" : "Show" %> message activity</span>
          </span>
        <% end %>
      <% end %>
      <% people = named.select { |grant| grant.user_id.present? } %>
      <% if people.any? %>
        <div class="menu-sep"></div>
        <% people.each do |grant| %>
          <span class="btn">
            <span class="who">
              <%= avatar(grant.user_id) %>
              <span class="two-line">
                <b><%= person_name(grant.user_id) %></b>
                <span>Granted by <%= person_name(grant.granted_by) %> &middot;
                  <%= on_day(grant.granted_at) %></span>
              </span>
            </span>
          </span>
        <% end %>
      <% end %>
  <% end %>
<% end %>
