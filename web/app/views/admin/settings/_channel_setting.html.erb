<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title"><%= title %></h2>
    <% if may_grant? %>
      <div class="card-tools">
        <%= form_with url: url, method: :post, class: "contents" do %>
          <%= render "shared/combobox", kind: "channel", name: :channel_id, submit: true,
                url: search_admin_channels_path, trigger: channel_id ? "Move it" : "Pick a channel" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if channel_id %>
    <div class="scroll">
      <table class="data-table">
        <thead><tr><th>Channel</th></tr></thead>
        <tbody>
          <tr>
            <td>
              <%= channel_cell(channel_id, channels_by_id[channel_id]) %>
              <%= channel_seat_label(*seat) if seat %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title sev-crit"><%= warning %></p>
    </div>
  <% end %>
</div>
