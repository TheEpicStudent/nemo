<% content_for :page_title, "Nemo channels" %>

<div class="stack">
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Channels Nemo joins</h2>
        <p class="card-sub"><%= AdminHelper::JOIN_NOTES[@join_mode] %></p>
      </div>
      <% if may_grant? %>
        <div class="card-tools">
          <%= admin_join_mode_switch(@join_mode) %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Channel assignments</h2>
    </div>
    <div class="setlist">
      <%= render "channel_setline", title: "Firehouse", channel_id: @firehouse,
            url: admin_settings_firehouse_path, channels_by_id: @channels_by_id, membership: @memberships[@firehouse] %>
      <%= render "channel_setline", title: "Shroud reports", channel_id: @reports_channel,
            url: admin_settings_reports_channel_path, channels_by_id: @channels_by_id, membership: @memberships[@reports_channel] %>
      <%= render "channel_setline", title: "Internal logs", channel_id: @log_channel,
            url: admin_settings_log_channel_path, channels_by_id: @channels_by_id, membership: @memberships[@log_channel] %>
    </div>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Case reaction channels</h2>
      <% if may_grant? %>
        <div class="card-tools">
          <%= form_with url: admin_settings_react_channels_path, method: :post,
                class: "contents" do %>
            <%= render "shared/combobox", kind: "channel", name: :channel_id, submit: true,
                  trigger_css: "btn btn-sm", url: search_admin_channels_path, trigger: "Add channel" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @react_channels.any? %>
      <div class="setlist">
        <% @react_channels.each do |channel_id| %>
          <div class="setline">
            <div class="setname">
              <%= channel_cell(channel_id, @channels_by_id[channel_id]) %>
              <%= channel_membership_label(*@memberships[channel_id]) %>
            </div>
            <% if may_grant? %>
              <div class="setval">
                <%= button_to "Remove", admin_settings_react_channel_path(channel_id),
                      method: :delete, class: "btn btn-sm", form: { class: "contents" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No channels configured</p>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Trusted senders</h2>
      <% if may_grant? %>
        <div class="card-tools">
          <%= form_with url: admin_settings_trusted_senders_path, method: :post, class: "contents" do %>
            <%= render "shared/combobox", name: :user_id, single: true, submit: true,
                  trigger_css: "btn btn-sm", url: fd_member_search_path(bots: 1), trigger: "Add sender" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @trusted_senders.any? %>
      <div class="setlist">
        <% @trusted_senders.each do |user_id| %>
          <div class="setline">
            <div class="setname"><%= member_face(user_id) %></div>
            <% if may_grant? %>
              <div class="setval">
                <%= button_to "Remove", admin_settings_trusted_sender_path(user_id),
                      method: :delete, class: "btn btn-sm", form: { class: "contents" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No trusted senders</p>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Guard expiry</h2>
      <% if may_grant? %>
        <div class="card-tools">
          <%= submit_tag "Save", class: "btn btn-sm btn-primary", form: "sweep-form" %>
        </div>
      <% end %>
    </div>
    <%= form_with url: admin_settings_sweep_path, method: :post, id: "sweep-form" do %>
      <div class="setlist">
        <label class="setline">
          <span class="setname">Expiry notice (hours)</span>
          <span class="setval">
            <%= number_field_tag :soon_hours, @soon_hours, class: "input", id: nil,
                  min: 1, max: Fd::AppSetting::MAX_SOON_HOURS,
                  disabled: !may_grant? %>
          </span>
        </label>
        <label class="setline">
          <span class="setname">Notify member on guard end</span>
          <span class="setval">
            <%= check_box_tag :tells, "1", @tells_member, class: "switch", id: nil,
                  disabled: !may_grant? %>
          </span>
        </label>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Account actions</h2>
      <% if may_grant? %>
        <div class="card-tools">
          <%= submit_tag "Save", class: "btn btn-sm btn-primary", form: "accounts-form" %>
        </div>
      <% end %>
    </div>
    <%= form_with url: admin_settings_accounts_path, method: :post, id: "accounts-form" do %>
      <div class="setlist">
        <label class="setline">
          <span class="setname">Deactivate on ban</span>
          <span class="setval"><%= admin_account_mode_select(:deactivate, @deactivate_mode) %></span>
        </label>
        <label class="setline">
          <span class="setname">Sign out repeat posters</span>
          <span class="setval"><%= admin_account_mode_select(:session_reset, @session_reset_mode) %></span>
        </label>
        <label class="setline">
          <span class="setname">Replies before sign-out</span>
          <span class="setval">
            <%= number_field_tag :strikes, @reset_strikes, class: "input", id: nil,
                  min: 1, max: Fd::AppSetting::MAX_STRIKES, disabled: !may_grant? %>
          </span>
        </label>
        <label class="setline">
          <span class="setname">Sign-outs per locked thread</span>
          <span class="setval">
            <%= number_field_tag :resets, @reset_max, class: "input", id: nil,
                  min: 0, max: Fd::AppSetting::MAX_RESETS, disabled: !may_grant? %>
          </span>
        </label>
      </div>
    <% end %>
  </div>
</div>
