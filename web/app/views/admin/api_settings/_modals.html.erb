<% @settings.each do |key, value| %>
  <%= render layout: "fd/modal", locals: { id: "setting-#{key}", title: setting_label(key),
        sub: "Current: #{value}" } do %>
    <%= form_with url: admin_api_setting_path, method: :patch, html: { autocomplete: "off" } do %>
      <%= hidden_field_tag :key, key, id: nil %>
      <div class="modal-body">
        <label class="field-label">
          Value
          <%= number_field_tag :value, value, id: nil, min: 1, class: "num-in num-in input" %>
        </label>
        <div class="facts-grid">
          <div class="cell">
            <span class="figure-key">Current</span>
            <span class="figure-value"><%= value %></span>
          </div>
          <div class="cell">
            <span class="figure-key">Tokens affected</span>
            <span class="figure-value"><%= setting_applies_to(key, @tokens) %></span>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% @tokens.reject(&:inactive?).each do |token| %>
  <%= render layout: "fd/modal", locals: { id: "rate-#{token.id}",
        title: "Rate for #{token.name}", sub: "Owner: #{names[token.owner_user_id]}" } do %>
    <%= form_with url: admin_api_token_rate_path(token), method: :patch,
          html: { autocomplete: "off" } do %>
      <div class="modal-body">
        <label class="field-label">
          Rate limit
          <%= number_field_tag :value, token.rate_limit, id: nil, min: 1, class: "num-in num-in input",
                placeholder: "Default #{@settings['rate_per_minute']}" %>
        </label>
        <div class="facts-grid">
          <div class="cell">
            <span class="figure-key">Requests, 30 days</span>
            <span class="figure-value"><%= number_with_delimiter(@request_counts[token.id].to_i) %></span>
          </div>
          <div class="cell">
            <span class="figure-key">Current</span>
            <span class="figure-value"><%= token.rate %>/min</span>
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <%= button_to "Revoke", admin_api_token_path(token), method: :delete,
              class: "btn btn-danger", form: { class: "contents" } %>
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
