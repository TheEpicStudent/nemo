<% content_for :page_title, "Public API" %>

<div class="metrics">
  <%= render "shared/stat", k: "Opted in", v: number_with_delimiter(@opted_in),
        caption: pluralize(Api::Scope::KEYS.size, "scope") %>
  <%= render "shared/stat", k: "Apps", v: @apps,
        caption: "#{@approved_count} approved" %>
  <%= render "shared/stat", k: "Live keys", v: @tokens.count { |token| !token.inactive? },
        caption: pluralize(@tokens.map(&:app_id).uniq.size, "app") %>
  <%= render "shared/stat", k: "Checks, 30 days", v: number_with_delimiter(@checks),
        caption: pluralize(@channels, "channel") %>
  <%= render "shared/stat", k: "Withheld", v: number_with_delimiter(@withheld_count),
        caption: withheld_percentage(@withheld_count, @checks) %>
</div>

<div class="stack">
  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Configuration</h2>
    </div>

    <div class="setlist">
      <div class="setline">
        <span class="setname"><%= Fd::Flag.label(:public_api) %></span>
        <span class="setval cap-do">
          <%= flag_switch(:public_api) %>
        </span>
      </div>
      <% @settings.each do |key, value| %>
        <div class="setline">
          <span class="setname"><%= setting_label(key) %></span>
          <span class="setval cap-do">
            <b class="row-value"><%= value %></b>
            <% if may_grant? %>
              <button type="button" class="btn btn-sm" data-modal-open="setting-<%= key %>" aria-haspopup="dialog">Change</button>
            <% end %>
          </span>
        </div>
      <% end %>
      <div class="setline">
        <span class="setname">Last sync</span>
        <span class="setval <%= "is-none" unless @synced %>"><%= synced_line(@synced) %></span>
      </div>
      <div class="setline">
        <span class="setname">Last changed</span>
        <% changed = setting_last_change(@last_setting) %>
        <span class="setval <%= "is-none" if changed.to_s == "Never" %>"><%= changed %></span>
      </div>
    </div>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <h2 class="card-title">Tokens</h2>
      <div class="card-tools">
        <span class="card-sub">
          <%= @tokens.count { |token| !token.inactive? } %> live &middot;
          <%= @tokens.count(&:inactive?) %> inactive
        </span>
      </div>
    </div>

    <% if @tokens.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>App</th>
              <th>Key name</th>
              <th>Key</th>
              <th class="col-num">Rate</th>
              <th class="col-num">Expires</th>
              <th class="col-num">Requests, 30 days</th>
              <th class="col-date">Last used</th>
              <th class="col-btn"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @tokens.each do |token| %>
              <tr>
                <td>
                  <span class="row-name">
                    <%= avatar(token.owner_user_id) %>
                    <span class="two-line">
                      <b><%= token.app.name %></b>
                      <span><%= person_name(token.owner_user_id) %></span>
                    </span>
                  </span>
                </td>
                <td class="<%= "sub" if token.revoked? %>"><%= token.name %></td>
                <td><code class="tag"><%= token.display_prefix %></code></td>
                <td class="col-num <%= "rate-own" if token.rate_limit %>">
                  <%= token.revoked? ? "n/a" : token.rate %>
                </td>
                <td class="col-num"><%= token.inactive? ? "n/a" : token.expires_in_label %></td>
                <td class="col-num"><%= number_with_delimiter(@request_counts[token.id].to_i) %></td>
                <td class="col-date">
                  <%= token.last_used_at ? "#{time_ago_in_words(token.last_used_at)} ago" : "Never" %>
                </td>
                <td class="col-btn">
                  <% if token.revoked? %>
                    <span class="chip chip-crit">
                      Revoked <%= token.revoked_at.strftime("%-d %b") %>
                    </span>
                  <% elsif may_grant? %>
                    <button type="button" class="btn btn-sm" data-modal-open="rate-<%= token.id %>" aria-haspopup="dialog">Set rate</button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No tokens</p>
      </div>
    <% end %>
  </div>
</div>

<% if may_grant? %>
  <%= render "admin/api_settings/modals" %>
<% end %>
